<!--
  The Drachenjaeger, built on Vehicle Framework.

  ONLY LOADED WHEN THE FRAMEWORK IS ACTIVE - this folder sits behind
  IfModActive="SmashPhil.VehicleFramework" in LoadFolders.xml.

  WHY A VEHICLE AND NOT AN EXOSUIT

  The starShell and this are both often called "armour", and putting them on the
  same framework would be a mistake. A starShell is four metres and worn; a
  Drachenjaeger is FORTY, is filed under Vehicles on the reference wiki, and has a
  cockpit hunched between its shoulders in place of a head. Its operators have
  bolts installed in their joints to sync with it, the way a Blue syncs with a
  ship. It is crewed, not worn.

  STRUCTURE, verified against Vanilla Vehicles Expanded's Bunsen - the installed
  worked example. Three defs are needed and they cross-reference:

    Vehicles.VehicleDef       the pawn itself, with roles and turretIds
    Vehicles.VehicleTurretDef one per weapon, matched by turretId
    Vehicles.VehicleBuildDef  the blueprint, named by the VehicleDef's buildDef

  DELIBERATE SIMPLIFICATIONS, stated rather than hidden:

  - The reference gives it SIX arms with elbow-mounted particle cannons, ion
    cleavers and nuclear warheads. Six turrets would be unreadable on a RimWorld
    map and unplayable to aim, so it carries two: a particle cannon battery and a
    warhead rack. The six arms belong in the artwork, not in the def.
  - shaderType is plain Cutout, not CutoutComplexPattern. The pattern shader needs
    a three-mask texture set that placeholder art cannot provide; some VVE vehicles
    use plain Cutout, so this is a supported path rather than a workaround.
  - Size is (4,6) - large, but a literal forty-metre footprint would be roughly
    seven tiles across and could not path through anything a colony builds.
    Flagged as a balance judgement, not a reading of the source.
-->
<Defs>

  <!-- ============================== research ============================== -->

  <ResearchProjectDef>
    <defName>RR_DrachenjagerFrame</defName>
    <label>Drachenjaeger frame</label>
    <description>A walking gun platform tall enough to fight ships. The pilot does not sit in it so much as become briefly continuous with it, through ports drilled into the joints, and the surgery to accept those ports is not reversible.\n\nThey were built to break sieges, and they are the only thing in the setting a Gold in pulse armour is genuinely afraid of.\n\nUnlocks the Drachenjaeger.</description>
    <tab>RR_Artificer</tab>
    <baseCost>9000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>RR_StarShellFrame</li>
      <li>RR_NeuralInterface</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <researchViewX>7.00</researchViewX>
    <researchViewY>2.50</researchViewY>
  </ResearchProjectDef>

  <!-- ============================ projectiles ============================= -->

  <ThingDef ParentName="BaseBullet">
    <defName>RR_Bullet_ParticleCannon</defName>
    <label>particle lance</label>
    <graphicData>
      <texPath>Things/Projectile/RR_ParticleLance</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.4</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>42</damageAmountBase>
      <armorPenetrationBase>0.90</armorPenetrationBase>
      <explosionRadius>1.4</explosionRadius>
      <stoppingPower>4</stoppingPower>
      <speed>110</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>RR_Bullet_WarheadRack</defName>
    <label>warhead</label>
    <graphicData>
      <texPath>Things/Projectile/RR_Warhead</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.6</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>85</damageAmountBase>
      <armorPenetrationBase>1.20</armorPenetrationBase>
      <explosionRadius>4.2</explosionRadius>
      <speed>52</speed>
    </projectile>
  </ThingDef>

  <!-- ============================== turrets =============================== -->

  <Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
    <defName>RR_Drachenjager_ParticleCannon</defName>
    <label>elbow particle battery</label>
    <description>Particle cannons jointed at the elbows, so the mech aims by moving its arms rather than by turning a turret. Accurate, relentless, and the reason infantry do not contest open ground against one.</description>
    <turretType>Rotatable</turretType>
    <projectile>RR_Bullet_ParticleCannon</projectile>
    <reloadTimer>6.0</reloadTimer>
    <warmUpTimer>1.4</warmUpTimer>
    <magazineCapacity>12</magazineCapacity>
    <chargePerAmmoCount>1</chargePerAmmoCount>
    <genericAmmo>true</genericAmmo>
    <autoSnapTargeting>false</autoSnapTargeting>
    <rotationSpeed>4.2</rotationSpeed>
    <projectileOffset>3</projectileOffset>
    <maxRange>34.9</maxRange>
    <minRange>4.9</minRange>
    <fireModes>
      <li>
        <shotsPerBurst>3</shotsPerBurst>
        <ticksBetweenBursts>14</ticksBetweenBursts>
        <spreadRadius>1.2</spreadRadius>
        <label>Burst</label>
        <texPath>UI/Gizmos/FireRate_Burst</texPath>
      </li>
      <li>
        <shotsPerBurst>1</shotsPerBurst>
        <ticksBetweenBursts>1</ticksBetweenBursts>
        <spreadRadius>0.4</spreadRadius>
        <label>Single</label>
        <texPath>UI/Gizmos/FireRate_Single</texPath>
      </li>
    </fireModes>
    <graphicData>
      <texPath>Things/Vehicles/RR_Drachenjager/RR_Drachenjager_ParticleCannon</texPath>
      <graphicClass>Vehicles.Graphic_Turret</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(4, 4)</drawSize>
    </graphicData>
    <ammunition>
      <thingDefs>
        <li>Plasteel</li>
      </thingDefs>
    </ammunition>
  </Vehicles.VehicleTurretDef>

  <Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
    <defName>RR_Drachenjager_WarheadRack</defName>
    <label>warhead rack</label>
    <description>The spiked pack on its back, which is not armour. Slow to reload and indiscriminate, and carried for the specific case where a fortification has to stop existing.</description>
    <turretType>Rotatable</turretType>
    <projectile>RR_Bullet_WarheadRack</projectile>
    <reloadTimer>26.0</reloadTimer>
    <warmUpTimer>3.2</warmUpTimer>
    <magazineCapacity>2</magazineCapacity>
    <chargePerAmmoCount>10</chargePerAmmoCount>
    <genericAmmo>true</genericAmmo>
    <autoSnapTargeting>false</autoSnapTargeting>
    <rotationSpeed>2.0</rotationSpeed>
    <projectileOffset>2</projectileOffset>
    <maxRange>44.9</maxRange>
    <minRange>9.9</minRange>
    <fireModes>
      <li>
        <shotsPerBurst>1</shotsPerBurst>
        <ticksBetweenBursts>1</ticksBetweenBursts>
        <spreadRadius>2.4</spreadRadius>
        <label>Launch</label>
        <texPath>UI/Gizmos/FireRate_Single</texPath>
      </li>
    </fireModes>
    <graphicData>
      <texPath>Things/Vehicles/RR_Drachenjager/RR_Drachenjager_WarheadRack</texPath>
      <graphicClass>Vehicles.Graphic_Turret</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(4, 4)</drawSize>
    </graphicData>
    <ammunition>
      <thingDefs>
        <li>Uranium</li>
      </thingDefs>
    </ammunition>
  </Vehicles.VehicleTurretDef>

  <!-- ============================= the vehicle ============================= -->

  <!--
    Parented from the FRAMEWORK's BaseVehiclePawn, not from Vanilla Vehicles
    Expanded's VehiclePawn_Armored. VVE's chain adds its own movement-controller
    comp, so inheriting from it would quietly make VVE a second requirement for a
    folder gated only on the framework. Confirmed by locating each abstract:
    BaseVehiclePawn, VehicleTurretBase and VehicleBaseBuildable are all the
    framework's own.
  -->
  <Vehicles.VehicleDef ParentName="BaseVehiclePawn">
    <defName>RR_Drachenjager</defName>
    <label>Drachenjaeger</label>
    <description>A headless, boxy giant in a spiked backpack, its cockpit sunk between shoulders where a neck should be. Six arms, particle cannons at every elbow, and an ion cleaver in whichever hand is free.\n\nThe pilot is bolted into it. Ports drilled through the joints let them wear the machine's movements as their own, which is the only way anything that size can be made to fight rather than merely walk, and which is why a Drachenjaeger pilot is a specialist rather than a driver.\n\nIt was built to end sieges. It does that.</description>
    <graphicData>
      <texPath>Things/Vehicles/RR_Drachenjager/RR_Drachenjager</texPath>
      <graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(6,8)</drawSize>
    </graphicData>
    <fillPercent>0.90</fillPercent>
    <buildDef>RR_Drachenjager_Blueprint</buildDef>
    <size>(4,6)</size>
    <vehicleCategory>Combat</vehicleCategory>
    <techLevel>Spacer</techLevel>
    <vehicleType>Land</vehicleType>
    <statBases>
      <ArmorRating_Blunt>0.85</ArmorRating_Blunt>
      <ArmorRating_Sharp>1.20</ArmorRating_Sharp>
      <ArmorRating_Heat>1.40</ArmorRating_Heat>
      <Flammability>0</Flammability>
      <MarketValue>28000</MarketValue>
    </statBases>
    <vehicleStats>
      <Mass>1800</Mass>
      <!-- It walks. Nothing this size is quick, and it does not need to be. -->
      <MoveSpeed>4.2</MoveSpeed>
      <CargoCapacity>120</CargoCapacity>
      <RepairRate>0.3</RepairRate>
      <AccelerationRate>0.02</AccelerationRate>
    </vehicleStats>
    <race>
      <baseBodySize>12</baseBodySize>
    </race>
    <properties>
      <customRoadCosts AssignDefaults="0.8"/>
      <vehicleJobLimitations>
        <li>(RepairVehicle, 4)</li>
      </vehicleJobLimitations>
      <diagonalRotation>true</diagonalRotation>
      <manhunterTargetsVehicle>false</manhunterTargetsVehicle>
      <worldSpeedMultiplier>0.8</worldSpeedMultiplier>
      <winterSpeedMultiplier>1</winterSpeedMultiplier>
      <roles>
        <li>
          <key>pilot</key>
          <label>pilot</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <hitbox>
            <cells>
              <li>(1, 3)</li>
              <li>(2, 3)</li>
            </cells>
          </hitbox>
          <handlingTypes>
            <li>Movement</li>
          </handlingTypes>
        </li>
        <li>
          <key>gunner</key>
          <label>gunner</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <hitbox>
            <cells>
              <li>(1, 2)</li>
              <li>(2, 2)</li>
            </cells>
          </hitbox>
          <handlingTypes>Turret</handlingTypes>
          <turretIds>
            <li>particleCannon</li>
          </turretIds>
        </li>
        <li>
          <key>warheadOperator</key>
          <label>warhead operator</label>
          <slots>1</slots>
          <slotsToOperate>1</slotsToOperate>
          <hitbox>
            <cells>
              <li>(1, 1)</li>
              <li>(2, 1)</li>
            </cells>
          </hitbox>
          <handlingTypes>Turret</handlingTypes>
          <turretIds>
            <li>warheadRack</li>
          </turretIds>
        </li>
      </roles>
    </properties>
    <comps>
      <li Class="Vehicles.CompProperties_VehicleTurrets">
        <turrets>
          <li>
            <turretDef>RR_Drachenjager_ParticleCannon</turretDef>
            <key>particleCannon</key>
            <parentKey></parentKey>
            <renderProperties>
              <north>(0, 2.4)</north>
              <east>(1.6, 0.8)</east>
              <south>(0, -1.2)</south>
              <west>(-1.6, 0.8)</west>
            </renderProperties>
          </li>
          <li>
            <turretDef>RR_Drachenjager_WarheadRack</turretDef>
            <key>warheadRack</key>
            <parentKey></parentKey>
            <renderProperties>
              <north>(0, -0.8)</north>
              <east>(-0.8, -0.4)</east>
              <south>(0, 1.6)</south>
              <west>(0.8, -0.4)</west>
            </renderProperties>
          </li>
        </turrets>
      </li>
    </comps>
  </Vehicles.VehicleDef>

  <!-- ============================ the blueprint ============================ -->

  <Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
    <defName>RR_Drachenjager_Blueprint</defName>
    <label>Drachenjaeger</label>
    <description>A walking gun platform tall enough to fight ships, and an accounting decision every time it is switched on.</description>
    <designationCategory>VF_Vehicles</designationCategory>
    <graphicData>
      <texPath>Things/Vehicles/RR_Drachenjager/RR_Drachenjager</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(6,8)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>4200</MaxHitPoints>
      <WorkToBuild>140000</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <size>(4,6)</size>
    <researchPrerequisites>
      <li>RR_DrachenjagerFrame</li>
    </researchPrerequisites>
    <costList>
      <RR_Ionsteel>200</RR_Ionsteel>
      <Plasteel>900</Plasteel>
      <ComponentSpacer>60</ComponentSpacer>
      <Uranium>150</Uranium>
      <Steel>1200</Steel>
    </costList>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <!--
      THE BACK-REFERENCE, and leaving it out is what made the architect slot blank.

      VehicleDef.buildDef points here; this must point back. VehicleGui's
      GizmoOnGUIWithMaterial opens with

          VehicleDef thingToSpawn = buildDef.thingToSpawn;

      and dereferences thingToSpawn.graphicData immediately after, so a missing
      link throws a NullReferenceException on EVERY FRAME the Vehicles tab is
      open - about a hundred a second - while the def itself loads perfectly
      cleanly and shows up as an empty square.

      Nothing in the load log names this def. The only thing that identifies it is
      the OnGUI stack trace.
    -->
    <thingToSpawn>RR_Drachenjager</thingToSpawn>
  </Vehicles.VehicleBuildDef>

</Defs>
