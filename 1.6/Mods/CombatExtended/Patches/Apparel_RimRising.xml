<?xml version="1.0" encoding="utf-8"?>
<!--
  Combat Extended compatibility - apparel.

  Optional; this folder only loads when CE is active.

  CE rescales armor completely. Vanilla ArmorRating_Sharp is a 0..1 damage
  reduction fraction, where marine armor sits at 1.06. CE reads the same stat as
  millimetres of steel equivalent and gives marine armor 20. Leaving our 1.24 in
  place under CE would mean pulse armor stopped roughly nothing.

  Scaled against CE's own figures for marine armor - Sharp 20, Blunt 45, Bulk 100,
  WornBulk 15, Mass 50 - with each piece placed relative to that.
  Re-checked against CE-Continued master on 2026-10-25 (Apparel_Various.xml,
  ApparelArmorPowerBase): unchanged, plus CarryWeight 80 / CarryBulk 10.

  Bulk is CE's encumbrance system and has no vanilla equivalent, so every piece
  needs it or it weighs nothing to carry.
-->
<Patch>

  <!-- ============================= pulse armor ============================ -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_PulseArmor"]/statBases/ArmorRating_Sharp</xpath>
    <value>
      <ArmorRating_Sharp>24</ArmorRating_Sharp>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_PulseArmor"]/statBases/ArmorRating_Blunt</xpath>
    <value>
      <ArmorRating_Blunt>52</ArmorRating_Blunt>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_PulseArmor"]/statBases/Mass</xpath>
    <value>
      <Mass>55</Mass>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_Apparel_PulseArmor"]/statBases</xpath>
    <value>
      <Bulk>110</Bulk>
      <WornBulk>16</WornBulk>
      <!-- The integrated helm's optics: CE's marine helmet is 0.6, its recon
           helmet 0.7 (Patches/Core/ThingDefs_Misc/Apparel_Hats.xml). -->
      <NightVisionEfficiency_Apparel>0.7</NightVisionEfficiency_Apparel>
    </value>
  </Operation>

  <!-- Suit comms: CE's radio flag, as it gives the recon helmet. -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="RR_Apparel_PulseArmor"]</xpath>
    <value>
      <li Class="CombatExtended.ApparelDefExtension">
        <isRadioPack>true</isRadioPack>
      </li>
    </value>
  </Operation>

  <!--
    The servo assistance, in CE terms. Vanilla expresses it as MoveSpeed and
    MeleeDamageFactor, which are kept; CE adds load-bearing on top, and CE's own
    power armor patch does the same. The suit carrying its wearer is the point of
    it, so under CE it should carry their gear too.
  -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_Apparel_PulseArmor"]/equippedStatOffsets</xpath>
    <value>
      <CarryWeight>85</CarryWeight>
      <CarryBulk>12</CarryBulk>
    </value>
  </Operation>

  <!-- ============================== demonHelm ============================= -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_DemonHelm"]/statBases/ArmorRating_Sharp</xpath>
    <value>
      <ArmorRating_Sharp>22</ArmorRating_Sharp>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_DemonHelm"]/statBases/ArmorRating_Blunt</xpath>
    <value>
      <ArmorRating_Blunt>40</ArmorRating_Blunt>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_DemonHelm"]/statBases/Mass</xpath>
    <value>
      <Mass>3.5</Mass>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_Apparel_DemonHelm"]/statBases</xpath>
    <value>
      <Bulk>8</Bulk>
      <WornBulk>2</WornBulk>
      <!-- Night and thermal sight, the helm's whole purpose: above CE's recon
           helmet (0.7), the best optic CE ships. -->
      <NightVisionEfficiency_Apparel>0.85</NightVisionEfficiency_Apparel>
    </value>
  </Operation>

  <!-- The helm's comms: CE's radio flag, as it gives the recon helmet. -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="RR_Apparel_DemonHelm"]</xpath>
    <value>
      <li Class="CombatExtended.ApparelDefExtension">
        <isRadioPack>true</isRadioPack>
      </li>
    </value>
  </Operation>

  <!-- ============================== scarabSkin ============================ -->

  <!--
    Deliberately poor armor under CE. Canonically scarabSkin is only slightly
    tougher than duroArmor and will not stop a razor, and CE's armor model makes
    that distinction meaningful in a way vanilla's fraction cannot: at Sharp 8 it
    turns small arms and is opened by anything serious.

    Very low bulk is the actual selling point. Under CE, encumbrance governs how
    fast a pawn moves and aims, so a near-weightless suit is a genuine tactical
    choice rather than just a weaker option.
  -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_ScarabSkin"]/statBases/ArmorRating_Sharp</xpath>
    <value>
      <ArmorRating_Sharp>8</ArmorRating_Sharp>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_ScarabSkin"]/statBases/ArmorRating_Blunt</xpath>
    <value>
      <ArmorRating_Blunt>14</ArmorRating_Blunt>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_ScarabSkin"]/statBases/Mass</xpath>
    <value>
      <Mass>4</Mass>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_Apparel_ScarabSkin"]/statBases</xpath>
    <value>
      <Bulk>10</Bulk>
      <WornBulk>3</WornBulk>
    </value>
  </Operation>

  <!-- ============================= recoil armor ============================

    The six pieces below were added after this file was written and nobody came
    back to it - the same lapse that left the Reaper's razor with vanilla tools.
    Under CE their vanilla fractions were read as millimetres: recoil armour, the
    Society's elite suit, stopped 0.92 mm of steel, and none of them had Bulk, so
    they weighed nothing to carry.

    Recoil sits one step under pulse (24/52): just under the razor's lash and
    well under its point, which is the vanilla intent carried into CE units.
  -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_RecoilArmor"]/statBases/ArmorRating_Sharp</xpath>
    <value>
      <ArmorRating_Sharp>19</ArmorRating_Sharp>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_RecoilArmor"]/statBases/ArmorRating_Blunt</xpath>
    <value>
      <ArmorRating_Blunt>44</ArmorRating_Blunt>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_RecoilArmor"]/statBases/Mass</xpath>
    <value>
      <Mass>40</Mass>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_Apparel_RecoilArmor"]/statBases</xpath>
    <value>
      <Bulk>85</Bulk>
      <WornBulk>12</WornBulk>
    </value>
  </Operation>

  <!-- ============================== duroArmor ===============================

    Stamped plate for Grays. CE's armor vest (vanilla flak vest) is no longer a fixed
    rating: CE-Continued gives it StuffEffectMultiplierArmor 8 and lets the stuff
    decide. Sharp 10 / Blunt 22 is roughly a steel one, and duro sits there, which keeps the scorcher-versus-duro fight real and the
    razor-versus-duro fight a formality, exactly as the vanilla numbers do.
  -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_DuroArmor"]/statBases/ArmorRating_Sharp</xpath>
    <value>
      <ArmorRating_Sharp>10</ArmorRating_Sharp>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_DuroArmor"]/statBases/ArmorRating_Blunt</xpath>
    <value>
      <ArmorRating_Blunt>22</ArmorRating_Blunt>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_DuroArmor"]/statBases/Mass</xpath>
    <value>
      <Mass>12</Mass>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_Apparel_DuroArmor"]/statBases</xpath>
    <value>
      <Bulk>30</Bulk>
      <WornBulk>6</WornBulk>
    </value>
  </Operation>

  <!-- ============================== ghostCloak ==============================

    Almost no protection in vanilla (0.10 / 0.06) and the same here: cloth over
    a lattice. Light, because a Howler moves.
  -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_GhostCloak"]/statBases/ArmorRating_Sharp</xpath>
    <value>
      <ArmorRating_Sharp>2</ArmorRating_Sharp>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_GhostCloak"]/statBases/ArmorRating_Blunt</xpath>
    <value>
      <ArmorRating_Blunt>3</ArmorRating_Blunt>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_Apparel_GhostCloak"]/statBases</xpath>
    <value>
      <Bulk>6</Bulk>
      <WornBulk>1</WornBulk>
    </value>
  </Operation>

  <!-- ============================ gravBoots / skipBoots =====================

    Plasteel over the shin. The vanilla ratings exist only so CE does not log an
    all-zero-armour error; in CE units they stay token. Mass is kept (eighteen
    kilos is the gravBoots' whole drawback), Bulk is added so the weight is felt.
  -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_GravBoots"]/statBases/ArmorRating_Sharp</xpath>
    <value>
      <ArmorRating_Sharp>5</ArmorRating_Sharp>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_GravBoots"]/statBases/ArmorRating_Blunt</xpath>
    <value>
      <ArmorRating_Blunt>8</ArmorRating_Blunt>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_Apparel_GravBoots"]/statBases</xpath>
    <value>
      <Bulk>20</Bulk>
      <WornBulk>4</WornBulk>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_SkipBoots"]/statBases/ArmorRating_Sharp</xpath>
    <value>
      <ArmorRating_Sharp>3</ArmorRating_Sharp>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Apparel_SkipBoots"]/statBases/ArmorRating_Blunt</xpath>
    <value>
      <ArmorRating_Blunt>5</ArmorRating_Blunt>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_Apparel_SkipBoots"]/statBases</xpath>
    <value>
      <Bulk>8</Bulk>
      <WornBulk>2</WornBulk>
    </value>
  </Operation>

  <!-- ================================ aegis =================================

    No armour ratings in vanilla - it parries and projects a field rather than
    stopping anything itself - so there is nothing to rescale. Bulk only.
  -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_Apparel_Aegis"]/statBases</xpath>
    <value>
      <Bulk>5</Bulk>
      <WornBulk>1</WornBulk>
    </value>
  </Operation>

  <!-- ============================== Howler pelt ============================
    Stuffed from leather, so its armour is the stuff's and CE already rescales
    stuffs. Bulk only. -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_Apparel_HowlerPelt"]/statBases</xpath>
    <value>
      <Bulk>4</Bulk>
      <WornBulk>1</WornBulk>
    </value>
  </Operation>

</Patch>
