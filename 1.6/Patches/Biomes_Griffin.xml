<?xml version="1.0" encoding="utf-8" ?>
<!--
  Wild griffins in cold, high country (the user's call, 2026-10-09; the setting has
  them living wild in cold climates and at altitude). Vanilla's own cold biomes,
  Core/Defs/BiomeDefs/Biomes_Cold.xml: the megasloth, also body size 4, sits at
  0.1-0.2 there, so the griffin is set well below it - a rare sight.

  Core defs, always present, so no FindMod guard; success Always only so another
  mod rewriting a biome's animal list degrades quietly.
-->
<Patch>

  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/BiomeDef[defName="Tundra"]/wildAnimals</xpath>
    <value>
      <RR_Griffin>0.06</RR_Griffin>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/BiomeDef[defName="IceSheet"]/wildAnimals</xpath>
    <value>
      <RR_Griffin>0.05</RR_Griffin>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/BiomeDef[defName="BorealForest"]/wildAnimals</xpath>
    <value>
      <RR_Griffin>0.03</RR_Griffin>
    </value>
  </Operation>

</Patch>
