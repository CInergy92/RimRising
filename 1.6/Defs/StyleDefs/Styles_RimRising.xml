<!--
  Caste marks. Suggestion 1.8.

  Blues shave and tattoo their scalps with the traces of the lattice; Obsidians are
  stained in patterns their tribe reads; Grays carry their unit on the forearm.
  Peerless Golds are scarred, and that is done already (Precepts_Scarification.xml).

  HOW THEY ARE ASSIGNED. Imposed by Color (user's call, 2026-10-09): a pawn kind
  names a style tag (RR_BlueMarks, RR_GrayMarks, RR_ObsidianMarks) in its
  styleItemTags, and Source/RimRising/CasteMarks.cs stamps the matching tattoo on
  after generation, the tag's weight being the chance. Vanilla's style roll could
  never do it: a pawn with an ideoligion only gets tattoos its culture or memes tag,
  and kind tags only weight within that set (rrtestmode=m12 measured 0 of 30).
  Colonists and wanderers, as with backstories, are not reached.
  STRUCTURE. styleTags, texPath, label and defName are the HairDef fields from
  Vanilla Hair Expanded (1.6/Defs/HairDefs/HairsViking.xml); a TattooDef is a StyleItemDef
  like a HairDef. The one field a tattoo has that a hair does not is tattooType
  (Face or Body), verified against Ideology/Defs/TattooDefs/. TattooDef.GraphicFor is
  a Graphic_Multi, so each needs _south/_east/_north; the icon falls back to _south.

  TEXTURES are Ideology's tattoo convention: 128x128 overlays per facing
  (<texPath>_south, _north, _east) matched to the head or body. These are placeholders
  and need the icon pipeline (New-XenotypeIcons.ps1 owns glyph art; a tattoo is a
  glyph on skin) - docs/Opus-Notes.md.
-->
<Defs>

  <TattooDef>
    <defName>RR_Tattoo_DigiTat</defName>
    <label>digiTat</label>
    <tattooType>Face</tattooType>
    <texPath>Things/Pawn/Humanlike/Tattoos/RR_DigiTat</texPath>
    <styleTags>
      <li>RR_BlueMarks</li>
    </styleTags>
  </TattooDef>

  <TattooDef>
    <defName>RR_Tattoo_ObsidianStain</defName>
    <label>tribal stain</label>
    <tattooType>Body</tattooType>
    <texPath>Things/Pawn/Humanlike/Tattoos/RR_ObsidianStain</texPath>
    <styleTags>
      <li>RR_ObsidianMarks</li>
    </styleTags>
  </TattooDef>

  <TattooDef>
    <defName>RR_Tattoo_ObsidianStainFace</defName>
    <label>stained brow</label>
    <tattooType>Face</tattooType>
    <texPath>Things/Pawn/Humanlike/Tattoos/RR_ObsidianStainFace</texPath>
    <styleTags>
      <li>RR_ObsidianMarks</li>
    </styleTags>
  </TattooDef>

  <TattooDef>
    <defName>RR_Tattoo_LegionMark</defName>
    <label>legion mark</label>
    <tattooType>Body</tattooType>
    <texPath>Things/Pawn/Humanlike/Tattoos/RR_LegionMark</texPath>
    <styleTags>
      <li>RR_GrayMarks</li>
    </styleTags>
  </TattooDef>

</Defs>
