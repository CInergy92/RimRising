<!--
  Apparel.

  Mirrored from Core/Defs/ThingDefs_Misc/Apparel_Various.xml - specifically
  ApparelArmorPowerBase, the abstract behind marine armor. Parented to Core's
  ArmorMachineableBase so no Royalty dependency is taken.

  PulseArmor is recoilArmor plus a shield generator plus servo assistance: it
  protects, and it also makes the wearer stronger and faster. That last part is
  the reason the Society is careful about who wears one, and it is why this suit
  gives positive movement and melee offsets where vanilla power armor gives a
  movement penalty.

  The cost is power. Canonically the suit runs on helium-3 and has a short battery
  life, which is represented here as heavy mass and a large equip delay rather
  than a fuel system - a real charge mechanic needs C# and belongs later, if at all.
-->
<Defs>

  <ThingDef ParentName="ArmorMachineableBase">
    <defName>RR_Apparel_PulseArmor</defName>
    <label>pulse armor</label>
    <description>Layered recoil plating over a servo harness, with a shield generator riding the spine. It stops what the plates can stop and shrugs off most of what they cannot, and underneath all that it is quietly multiplying the person inside - a suited Gold moves faster and hits harder than an unsuited one, which is the entire point of the design.\n\nIt is enormously expensive, drinks helium-3, and will overheat if the shield takes sustained punishment. None of that has ever discouraged anybody who was allowed to own one.</description>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisite>RR_PulseArmor</researchPrerequisite>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>230</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/RR_PulseArmor/RR_PulseArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <generateCommonality>0.5</generateCommonality>
    <statBases>
      <WorkToMake>78000</WorkToMake>
      <MaxHitPoints>400</MaxHitPoints>
      <Mass>16</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>1.24</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.58</ArmorRating_Blunt>
      <ArmorRating_Heat>0.68</ArmorRating_Heat>
      <Insulation_Cold>74</Insulation_Cold>
      <Insulation_Heat>14</Insulation_Heat>
      <EquipDelay>18</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <!--
        Servo assistance. Vanilla power armor slows the wearer; pulse armor is
        explicitly described as enhancing strength and speed, so it does the
        opposite. This is the suit's signature and the reason it costs what it does.
      -->
      <MoveSpeed>0.15</MoveSpeed>
      <MeleeDamageFactor>0.15</MeleeDamageFactor>
      <CarryingCapacity>35</CarryingCapacity>
      <!--
        The integrated helm's targeting system. Synched to a pulseFist it marks
        the seams in an opponent's armor and calls the shots. Royalty's gunlink -
        the nearest vanilla equivalent - gives ShootingAccuracyPawn +3; a full
        suit does rather more.
      -->
      <ShootingAccuracyPawn>6</ShootingAccuracyPawn>
      <AimingDelayFactor>-0.20</AimingDelayFactor>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.3</SlaveSuppressionOffset>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.5</VacuumResistance>
    </equippedStatOffsets>
    <tradeTags>
      <li>HiTechArmor</li>
      <li>Armor</li>
    </tradeTags>
    <costList>
      <ComponentSpacer>6</ComponentSpacer>
      <Plasteel>140</Plasteel>
      <Uranium>30</Uranium>
      <Gold>15</Gold>
    </costList>
    <apparel>
      <!--
        THE HELMET IS BUILT IN. PulseArmor is a sealed suit in the books, not a
        cuirass you pair with headgear - so it covers FullHead and occupies the
        Overhead layer itself rather than shipping a separate helmet piece. That
        also means it cannot be worn with a demonHelm, which is correct: the
        demonHelm goes with scarabSkin.
      -->
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/RR_PulseArmor/RR_PulseArmor</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>SpacerMilitary</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <forceEyesVisibleForRotations>
        <li>1</li>
        <li>2</li>
        <li>3</li>
      </forceEyesVisibleForRotations>
    </apparel>
  </ThingDef>

  <!--
    scarabSkin - the other half of the stealth kit.

    Deliberately layered OnSkin + Middle rather than Shell, for two reasons:
    canonically it is tightly fitted, and it leaves Shell free for a ghostCloak
    and Overhead free for the demonHelm. The full Howler loadout is
    scarabSkin + ghostCloak + demonHelm, and all three have to coexist.

    Contrast with pulse armor, which is the siege kit: sealed, helmeted, heavy,
    and occupies Middle + Shell + Overhead by itself.

    Canon: absorbs light and renders pitch black, emits no thermal signature,
    allows rapid movement, is slightly tougher than duroArmor, and carries no
    battery - which is what makes it immune to EMP.
  -->
  <ThingDef ParentName="ArmorMachineableBase">
    <defName>RR_Apparel_ScarabSkin</defName>
    <label>scarabSkin</label>
    <description>A skin rather than a suit: fitted close enough to move in, woven from a lattice that drinks light instead of reflecting it, so a wearer standing still in poor cover is very nearly not there. It gives off no heat signature and holds no charge, which means nothing to burn out and nothing for an EMP to find.\n\nIt will turn a blade and shrug off a light round, and it will do nothing whatsoever about a razor. Worn by people whose plan does not involve being shot at.</description>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <researchPrerequisite>RR_PolyenneWeaving</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>232</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/RR_ScarabSkin/RR_ScarabSkin</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <generateCommonality>0.6</generateCommonality>
    <statBases>
      <WorkToMake>34000</WorkToMake>
      <MaxHitPoints>180</MaxHitPoints>
      <Mass>3</Mass>
      <Flammability>0.2</Flammability>
      <ArmorRating_Sharp>0.62</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.24</ArmorRating_Blunt>
      <ArmorRating_Heat>0.40</ArmorRating_Heat>
      <Insulation_Cold>18</Insulation_Cold>
      <Insulation_Heat>6</Insulation_Heat>
      <EquipDelay>6</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <!-- "Enables rapid movement" - the whole point of wearing a skin. -->
      <MoveSpeed>0.25</MoveSpeed>
    </equippedStatOffsets>
    <tradeTags>
      <li>HiTechArmor</li>
    </tradeTags>
    <costList>
      <ComponentSpacer>2</ComponentSpacer>
      <Plasteel>60</Plasteel>
      <Hyperweave>20</Hyperweave>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/RR_ScarabSkin/RR_ScarabSkin</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
        <li>Middle</li>
      </layers>
      <tags>
        <li>SpacerMilitary</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
  </ThingDef>

  <!--
    demonHelm.

    NOT the pulseArmor's helmet - that suit is sealed and carries its own. The
    demonHelm is the separate piece, worn canonically with scarabSkin: the stealth
    kit rather than the siege kit. The full Howler loadout is scarabSkin + ghostCloak + demonHelm; the
    cloak is not built yet (see docs/PROGRESS.md).

    Canonically it lets the wearer see across most spectrums, mask their voice,
    amplify sound, track coordinates, read maps and talk silently. That sensor
    package is why it is an accuracy item rather than just a hat.

    Gated on the neural interface rather than on pulse armor, since it is a
    sensory and comms system, not pulse tech.

    Parented to Core's ArmorHelmetMakeableBase, which supplies thingCategories
    ArmorHeadgear and apparel/parentTagDef ApparelHead - neither is re-declared
    here, since list fields append on inherit.
  -->
  <ThingDef ParentName="ArmorHelmetMakeableBase">
    <defName>RR_Apparel_DemonHelm</defName>
    <label>demonHelm</label>
    <description>A pupil-black helm shaped, not quite subtly, like a screaming face. Inside it the world arrives pre-annotated: spectrums a human eye cannot hold, range and bearing on everything moving, maps, and the quiet voices of everyone else wearing one. It takes the wearer's voice away and hands back something colder.\n\nIt is light, unpowered where it can be, and meant to be worn with a skin rather than a suit - the equipment of people whose work depends on not being seen coming.</description>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisite>RR_NeuralInterface</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>231</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/RR_DemonHelm/RR_DemonHelm</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.25</uiIconScale>
    <generateCommonality>0.5</generateCommonality>
    <statBases>
      <WorkToMake>26000</WorkToMake>
      <MaxHitPoints>170</MaxHitPoints>
      <Mass>1.8</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>1.18</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.52</ArmorRating_Blunt>
      <ArmorRating_Heat>0.62</ArmorRating_Heat>
      <Insulation_Cold>6</Insulation_Cold>
      <Insulation_Heat>3</Insulation_Heat>
      <EquipDelay>5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <!--
        The reason to wear it: multi-spectrum sight and live target tracking.
        Slightly under the pulse armor's integrated helm, which has a whole suit
        and a synched pulseFist behind it, and well over Royalty's gunlink at +3.
      -->
      <ShootingAccuracyPawn>5</ShootingAccuracyPawn>
      <AimingDelayFactor>-0.15</AimingDelayFactor>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.4</VacuumResistance>
    </equippedStatOffsets>
    <tradeTags>
      <li>HiTechArmor</li>
    </tradeTags>
    <costList>
      <ComponentSpacer>2</ComponentSpacer>
      <Plasteel>50</Plasteel>
      <Gold>5</Gold>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/RR_DemonHelm/RR_DemonHelm</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>SpacerMilitary</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
    <comps>
      <li Class="CompProperties_Biocodable"/>
    </comps>
  </ThingDef>
  <!-- ============================== duroArmor ===============================

    Standard Gray issue, and the most common armour in the setting by a wide
    margin. Canonically it stops blades and about copes with an ionBlade; a razor
    or a pulseBlade goes straight through it.

    That last part is not flavour text, it is the numbers. Sharp 0.42 against the
    razor's 0.95 armour penetration means the razor is barely slowed - which is
    the caste gap made legible the moment a Gold walks into a room full of Grays.
    Against a scorcher's 0.15 it is genuinely useful, so Grays shooting at Grays
    is a real fight and Grays shooting at a Gold is not.

    No research prerequisite, deliberately. ArmorMachineableBase supplies none of
    its own, and this is meant to be the thing everybody already has.
  -->
  <ThingDef ParentName="ArmorMachineableBase">
    <defName>RR_Apparel_DuroArmor</defName>
    <label>duroArmor</label>
    <description>A stamped duroSteel cuirass with shoulder caps, issued by the crate and fitted by nobody. It turns a knife, blunts a club, and has saved a great many Grays from a great many things that were not aimed at them very carefully.

Against anything a Gold is carrying it is a formality. Everyone wearing one knows this.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/RR_DuroArmor/RR_DuroArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <Mass>7</Mass>
      <WorkToMake>9000</WorkToMake>
      <Flammability>0.4</Flammability>
      <EquipDelay>4</EquipDelay>
      <ArmorRating_Sharp>0.42</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.24</ArmorRating_Blunt>
      <ArmorRating_Heat>0.18</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold>
    </statBases>
    <equippedStatOffsets>
      <!-- Stamped plate that was never fitted to the wearer. -->
      <MoveSpeed>-0.10</MoveSpeed>
    </equippedStatOffsets>
    <costList>
      <Steel>75</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
      <displayPriority>190</displayPriority>
    </recipeMaker>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <tradeTags>
      <li>Armor</li>
    </tradeTags>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/RR_DuroArmor/RR_DuroArmor</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>IndustrialMilitaryBasic</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
  </ThingDef>
  <!-- ============================= recoilArmor ==============================

    The missing middle. duroArmor is what Grays are issued; pulseArmor is what a
    Gold wears; recoilArmor is the good suit underneath the good suit - canonically
    pulseArmor IS recoilArmor with a shield generator and limb motors added, which
    is why our pulseArmor description already calls itself recoil plating.

    Canon gives it one distinction worth building around: it is the only protection
    that guards against both pulse weapons AND razors. So its sharp rating is set
    just under the razor's 0.95 armour penetration - a razor still gets through, but
    it is the first thing in the mod that makes a Gold work for it.

    THE WOUND SEALING IS APPROXIMATED, and deliberately so. The plates close around
    a penetration, compress the wound and dose the wearer with painkillers. RimWorld
    has no bleed-rate stat to offset - bleeding lives on the injury hediff - so
    stopping bleeding literally would need C#. InjuryHealingFactor and
    PainShockThreshold both exist and are offsettable from apparel (vanilla's
    cultist mask offsets the latter), so the suit heals faster and hurts less
    instead. That is a fair reading, not the literal mechanic, and it is written
    down here so nobody later mistakes it for one.

    It carries no shield, which means an EMP does nothing to it. That is emergent
    rather than authored, and it happens to be exactly right: the plates work by
    chemistry and mechanics, not electronics.
  -->
  <ThingDef ParentName="ArmorMachineableBase">
    <defName>RR_Apparel_RecoilArmor</defName>
    <label>recoilArmor</label>
    <description>Interlocking plates that coil around the body when you put them on, closer to a liquid settling than a suit fastening. It takes a railgun round and gives back a dent. When something does get through, the plates clamp over the hole, squeeze it shut and push a dose of something kind into the wearer - which stops them bleeding out, and does nothing at all about the hole.

All of that is chemistry and springs rather than circuits, so it goes on working after everything electronic in the room has died. Bolt a shield generator and limb motors onto one and you have pulseArmor, which is precisely how pulseArmor is made.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/RR_RecoilArmor/RR_RecoilArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>320</MaxHitPoints>
      <Mass>12</Mass>
      <WorkToMake>42000</WorkToMake>
      <Flammability>0.2</Flammability>
      <EquipDelay>6</EquipDelay>
      <!-- Just under the razor's 0.95 penetration: a razor still wins, but not
           for free. Well above duroArmor's 0.42, well below pulseArmor's 1.24. -->
      <ArmorRating_Sharp>0.92</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.52</ArmorRating_Blunt>
      <ArmorRating_Heat>0.55</ArmorRating_Heat>
      <Insulation_Cold>16</Insulation_Cold>
      <Insulation_Heat>8</Insulation_Heat>
    </statBases>
    <equippedStatOffsets>
      <!-- The plates clamping over a wound, standing in for a bleed mechanic that
           does not exist as a stat. See the note above. -->
      <InjuryHealingFactor>0.35</InjuryHealingFactor>
      <PainShockThreshold>0.15</PainShockThreshold>
      <!-- It coils rather than clanks; no vanilla power-armour movement penalty. -->
      <MoveSpeed>-0.04</MoveSpeed>
    </equippedStatOffsets>
    <costList>
      <Plasteel>110</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
      <Steel>40</Steel>
    </costList>
    <recipeMaker>
      <researchPrerequisite>RR_Artificer</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <displayPriority>195</displayPriority>
    </recipeMaker>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <tradeTags>
      <li>Armor</li>
    </tradeTags>
    <apparel>
      <!-- NO head coverage, unlike pulseArmor. RecoilArmor is a suit rather than a
           sealed system, so it pairs with a demonHelm - which is the combination
           the scarabSkin-wearing units actually use. -->
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/RR_RecoilArmor/RR_RecoilArmor</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
        <li>SpacerMilitary</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
  </ThingDef>

</Defs>