<?xml version="1.0" encoding="utf-8" ?>
<!--
  Weapons.

  Melee mirrored from Royalty/Defs/ThingDefs_Misc/Weapons/MeleeUltratech.xml
  (MonoSword); ranged and projectile from Core/.../RangedSpacer.xml
  (Gun_ChargeRifle, Bullet_ChargeRifle).

  Deliberately parented to CORE abstracts - BaseMeleeWeapon, BaseHumanMakeableGun,
  BaseBullet - not to Royalty's MeleeWeaponUltratech, so Milestone 4 adds no new
  DLC dependency. Royalty arrives at Milestone 5 for the Gold rank ladder; the
  razor becomes a persona weapon then, which is what its fiction actually wants.

  CASTE RESTRICTION IS NOT IMPLEMENTED HERE. A razor is forbidden to every Color
  but Gold, on pain of death, and that is a social rule rather than a property of
  the object. It belongs in Milestone 5 as a precept reacting to a HistoryEvent.
  Nothing in this file stops a Red picking one up - the Society's objection is
  the point, and the Society is not built yet.
-->
<Defs>

  <!-- ================================ razor ================================ -->

  <ThingDef ParentName="BaseMeleeWeapon">
    <defName>RR_Weapon_Razor</defName>
    <label>razor</label>
    <description>A meter of polyenne fiber that holds two states: rigid, where it is harder than diamond and will open pulseArmor like a coat, and slack, where it becomes a whip twice its own length and behaves like nothing else on a battlefield. The toggle is a stud under the thumb.\n\nBuilt by Orange Bladeweavers, resistant to EMP, and good for centuries with maintenance. Among Golds it is less a weapon than a proof of standing, and the law is unambiguous about who may touch one.</description>
    <techLevel>Ultra</techLevel>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/RR_Razor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>52000</WorkToMake>
      <MarketValue>2600</MarketValue>
      <Mass>1.4</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>RR_PolyenneWeaving</researchPrerequisite>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>210</displayPriority>
    </recipeMaker>
    <costList>
      <Plasteel>60</Plasteel>
      <ComponentSpacer>3</ComponentSpacer>
      <Gold>10</Gold>
    </costList>
    <!--
      Inherit="False" IS REQUIRED, and the reason is not obvious. BaseWeapon
      supplies CompProperties_Forbiddable, CompEquippable and
      CompProperties_Styleable. CompEquippableAbility REPLACES CompEquippable
      rather than sitting beside it, so the inherited list has to be discarded and
      restated - which means Forbiddable and Styleable must be repeated here or
      the razor quietly loses the ability to be forbidden or restyled. Vanilla
      does exactly this for the bioferrite burner, with the same warning attached.

      CompProperties_EquippableAbility is the plain, ammo-free form. The only
      equippable-ability comp used anywhere in vanilla is the RELOADABLE subclass,
      which needs an ammoDef and charges; decompiling it showed it derives from
      this one, which carries nothing but an abilityDef. So a pure cooldown needs
      no C# and no ammo item.
    -->
    <comps Inherit="False">
      <li Class="CompProperties_EquippableAbility">
        <abilityDef>RR_RazorWhip</abilityDef>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Biocodable"/>
    </comps>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <weaponTags>
      <li>UltratechMelee</li>
      <!-- Keyed on by the caste restriction in Source/RimRising/HarmonyPatches.cs. -->
      <li>RR_CasteRestricted</li>
    </weaponTags>
    <!-- Melee comes from BaseMeleeWeapon; only the additions are declared here. -->
    <weaponClasses>
      <li>Ultratech</li>
      <li>MeleePiercer</li>
    </weaponClasses>
    <tools>
      <li>
        <label>hilt</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>1.5</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>26</power>
        <cooldownTime>1.9</cooldownTime>
        <!--
          Canonically a razor pierces both recoilArmor and pulseArmor. Vanilla's
          monosword sits at 0.9; the razor edges past it, which is the whole
          reason a Gold is frightening in a corridor.
        -->
        <armorPenetration>0.95</armorPenetration>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>27</power>
        <cooldownTime>1.9</cooldownTime>
        <armorPenetration>0.95</armorPenetration>
      </li>
      <li>
        <!-- The whip state: longer reach, wider arc, less concentrated force. -->
        <label>lash</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>20</power>
        <cooldownTime>1.4</cooldownTime>
        <armorPenetration>0.6</armorPenetration>
      </li>
    </tools>
  </ThingDef>

  <!-- ============================== pulseFist ============================== -->

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>RR_Weapon_PulseFist</defName>
    <label>pulseFist</label>
    <description>A gauntlet that throws superheated pulse energy hard enough to melt snow off stone and put a hole through the person standing behind the person you aimed at. It is the ordinary sidearm of Golds fighting other Golds, which tells you most of what you need to know about how Golds fight.\n\nSustained fire will cook the emitter and collapse the housing. Every user has been told this and most have done it anyway.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/RR_PulseFist</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>42000</WorkToMake>
      <MarketValue>1900</MarketValue>
      <Mass>2.8</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.35</AccuracyLong>
      <RangedWeapon_Cooldown>1.60</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>RR_PulsePhysics</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>220</displayPriority>
    </recipeMaker>
    <costList>
      <Plasteel>45</Plasteel>
      <ComponentSpacer>3</ComponentSpacer>
      <Uranium>5</Uranium>
    </costList>
    <weaponTags>
      <li>SpacerGun</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>RR_Bullet_PulseFist</defaultProjectile>
        <warmupTime>0.9</warmupTime>
        <!-- Gauntlet-mounted: brutal up close, useless at distance. -->
        <range>19.9</range>
        <ticksBetweenBurstShots>9</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>gauntlet</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>11</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>RR_Bullet_PulseFist</defName>
    <label>pulse blast</label>
    <graphicData>
      <texPath>Things/Projectile/Charge_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Flame</damageDef>
      <damageAmountBase>18</damageAmountBase>
      <armorPenetrationBase>0.45</armorPenetrationBase>
      <speed>62</speed>
    </projectile>
  </ThingDef>

  <!-- ========================= the razor's whip form =========================

    A razor toggles between a rigid blade and a whip roughly twice its length.
    The blade is the weapon's ordinary melee; the whip is this: a lash out to
    just under eight cells, on a flat cooldown with no ammunition.

    The AbilityDef and its projectile are colocated with the weapon rather than
    filed under Defs/AbilityDefs, following vanilla - Anomaly keeps the bioferrite
    burner's AbilityDef inside Weapons_Ranged.xml beside the gun that grants it.
  -->
  <AbilityDef>
    <defName>RR_RazorWhip</defName>
    <label>whip form</label>
    <description>Release the razor's spine and let it uncoil to twice its length, then lash. The blade is limp until the instant it lands, which is what lets it reach around cover and why it cannot simply be parried. Recovering the edge and stiffening it again takes time the wielder does not have in a melee, so it is used to open a fight rather than to win one.</description>
    <iconPath>UI/Abilities/RR_RazorWhip</iconPath>
    <!-- Fifteen seconds. Long enough that it opens an engagement rather than
         replacing the razor's melee, which is the whole point of carrying one. -->
    <cooldownTicksRange>900</cooldownTicksRange>
    <displayOrder>100</displayOrder>
    <!-- It belongs to the weapon, not the pawn, so it does not belong on the
         character card. Vanilla does the same for the bioferrite burner. -->
    <showOnCharacterCard>false</showOnCharacterCard>
    <!-- Enemy Golds use it too. They are meant to be dangerous. -->
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>7.9</range>
      <warmupTime>0.6</warmupTime>
      <!-- Ability cast sounds live on the verb, as Anomaly's spine launch does. -->
      <soundCast>RR_RazorLash</soundCast>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>RR_Bullet_RazorLash</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>RR_Bullet_RazorLash</defName>
    <label>razor lash</label>
    <graphicData>
      <texPath>Things/Projectile/RR_RazorLash</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Cut</damageDef>
      <!-- Below the razor's own 26-power stab. Reach is what the whip buys; it
           is not also meant to be the harder hit. -->
      <damageAmountBase>19</damageAmountBase>
      <!-- Canonically a razor cuts through armour. This stays under the blade's
           own penetration for the same reason as the damage. -->
      <armorPenetrationBase>0.75</armorPenetrationBase>
      <speed>55</speed>
    </projectile>
  </ThingDef>

  <!-- ============================== scorcher ================================

    The other end of the Society from a razor. A scorcher works on the same idea
    as a railgun and does it badly: accurate, easy to shoot, and specifically
    unable to get through anything better than basic armour. It is what a Gray
    carries because a pulseFist is either unaffordable or not permitted.

    THE LOW ARMOUR PENETRATION IS THE POINT, not a balance compromise. At 0.15 it
    is stopped cold by pulseArmor (1.24 sharp) and merely inconvenienced by
    duroArmor (0.40) - which is exactly the gap between the castes, expressed in
    numbers a firefight will actually demonstrate.

    Reusing a vanilla projectile texture the way the pulseFist already does. Both
    reference Core paths rather than shipping our own, which is allowed - what is
    forbidden is WRITING a placeholder over a vanilla path.
  -->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>RR_Weapon_Scorcher</defName>
    <label>scorcher</label>
    <description>A cheap directed-energy carbine that whirrs while it charges and smells faintly of hot oil. It is easier to shoot straight than anything that uses gunpowder, which is why Grays are issued them by the crate.\n\nIt will not get through a pulseShield, and it will not get through good plate. Against a man in a work smock it is entirely sufficient, and the Society has thought carefully about who it expects Grays to be shooting.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/RR_Scorcher</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>16000</WorkToMake>
      <MarketValue>420</MarketValue>
      <Mass>3.2</Mass>
      <!-- Canonically more accurate and easier to use than a powder weapon. -->
      <AccuracyTouch>0.78</AccuracyTouch>
      <AccuracyShort>0.82</AccuracyShort>
      <AccuracyMedium>0.74</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>1.40</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <!-- ChargedShot, not our own tab def. A scorcher is a cheap directed-
           energy weapon and RR_PulsePhysics already requires ChargedShot, so
           this correctly sits BELOW pulse tech: basic kit before the good stuff. -->
      <researchPrerequisite>ChargedShot</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <displayPriority>230</displayPriority>
    </recipeMaker>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <weaponTags>
      <li>SpacerGun</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>RR_Bullet_Scorcher</defaultProjectile>
        <!-- The audible charge-up before it fires. -->
        <warmupTime>1.2</warmupTime>
        <range>25.9</range>
        <burstShotCount>1</burstShotCount>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>7</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>RR_Bullet_Scorcher</defName>
    <label>scorcher bolt</label>
    <graphicData>
      <texPath>Things/Projectile/Charge_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Burn</damageDef>
      <damageAmountBase>12</damageAmountBase>
      <!-- The whole character of the weapon. Basic armour only. -->
      <armorPenetrationBase>0.15</armorPenetrationBase>
      <speed>70</speed>
    </projectile>
  </ThingDef>

  <!-- ============================== the aegis ===============================

    Canonically a buckler that projects an OVAL energy field, carried by Golds in
    single combat and specifically in duels of honour. It can be taken into a
    battle, but against other Golds or Obsidians a full pulseShield covers more.

    WHY THIS IS NOT JUST A SHIELD BELT. Decompiling CompShield settles it:
    PostPreApplyDamage absorbs only when dinfo.Def.isRanged or isExplosive. Melee
    damage is neither, so a shield belt does nothing whatsoever against a razor -
    and there is no XML switch to change that. blocksRangedWeapons governs what
    the WEARER may fire, not what gets stopped. An aegis built purely from
    CompProperties_Shield would be exactly the wrong item: useless in the one
    situation it exists for.

    So the duelling defence is a MeleeDodgeChance offset instead - the aegis
    parries rather than absorbs, which is also the truer reading of a buckler.
    Vanilla offsets this stat by 15 on a trait and 8 on a hediff, so 20 here is
    substantial without being absurd. The shield comp is kept as well, at a
    deliberately smaller capacity than vanilla's shield belt, so the projected
    field still stops shots.

    Note what that combination costs: CompProperties_Shield refuses ranged weapon
    use. Carrying an aegis therefore means giving up the pulse fist, which is
    precisely the trade canon describes - you bring one to a duel, not to a war.
  -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>RR_Apparel_Aegis</defName>
    <label>aegis</label>
    <description>A palm-sized emitter on a forearm cuff, throwing an oval of hardened field about the size of a door. It is not much use against a barrage and was never meant to be - it exists for the moment when two people who both know exactly what they are doing stand inside each other's reach, and one of them has half a second more than the other.\n\nGolds duel with these. Everyone else who carries one is making a statement about themselves that they may not be able to support.</description>
    <techLevel>Spacer</techLevel>
    <thingClass>Apparel</thingClass>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/RR_Aegis/RR_Aegis</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>2.5</Mass>
      <WorkToMake>28000</WorkToMake>
      <Flammability>0.2</Flammability>
      <EquipDelay>2</EquipDelay>
      <!-- Vanilla's shield belt is 1.1 max / 0.13 recharge. The aegis holds less
           and recovers faster: a buckler, not a bubble. -->
      <EnergyShieldEnergyMax>0.75</EnergyShieldEnergyMax>
      <EnergyShieldRechargeRate>0.20</EnergyShieldRechargeRate>
    </statBases>
    <equippedStatOffsets>
      <MeleeDodgeChance>20</MeleeDodgeChance>
    </equippedStatOffsets>
    <costList>
      <Plasteel>40</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
      <Gold>5</Gold>
    </costList>
    <recipeMaker>
      <researchPrerequisite>RR_PolyenneWeaving</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>215</displayPriority>
    </recipeMaker>
    <!--
      ApparelUtility, matching vanilla's Apparel_ShieldBelt, which this is the
      analogue of. Without a category it is invisible to apparel policies and
      gets stripped off - see the note on pulse armour.
    -->
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <!-- Waist on the Belt layer, exactly as the shield belt does, so an aegis
           can be carried over pulse armor rather than instead of it. -->
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>RR_Aegis</li>
      </tags>
    </apparel>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <comps>
      <li Class="CompProperties_Shield" />
    </comps>
  </ThingDef>
  <!-- ========================== the Reaper's razor ==========================

    A razor holds whatever shape its bearer sets it to. Darrow sets his into a
    sickle - the slingBlade a Red cuts helium from Martian rock with - so the most
    feared weapon in the Society goes about wearing the shape of a mining tool.

    NOT A CORRECTION TO THE ORDINARY RAZOR, which is correctly a slim straight
    blade; this is the same object shaped differently, and it gets its own def for
    that reason.

    IT DOES NOT CARRY RR_CasteRestricted, and that is the entire point. The Gold
    monopoly on razors is enforced by a precept the Society's ideoligion holds; a
    Reaper's razor exists specifically to break it, so gating it to the ruling
    caste would invert its meaning. It is tagged RR_RisingWeapon instead, which is
    what the Sons of Ares pawnkinds draw from.

    Sickle geometry, so the numbers follow the shape: more cutting power than the
    straight razor and markedly less thrust. Armour penetration is unchanged -
    it is still a razor.
  -->
  <ThingDef ParentName="BaseMeleeWeapon">
    <defName>RR_Weapon_ReaperRazor</defName>
    <label>reaper's razor</label>
    <description>A razor set to a curve, which is a thing razors will do for anyone who knows the trick and a thing almost nobody does. The shape is a slingBlade - what a Red holds all day in a drill, cutting helium out of Martian rock - and the first person to carry one openly did it so that the people watching would understand the joke.

It cuts as well as any razor. It is worth rather more than that to the people who see it.</description>
    <techLevel>Ultra</techLevel>
    <equippedAngleOffset>-55</equippedAngleOffset>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/RR_ReaperRazor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>54000</WorkToMake>
      <MarketValue>2900</MarketValue>
      <Mass>1.5</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>RR_PolyenneWeaving</researchPrerequisite>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>211</displayPriority>
    </recipeMaker>
    <costList>
      <Plasteel>60</Plasteel>
      <ComponentSpacer>3</ComponentSpacer>
      <Gold>10</Gold>
    </costList>
    <!-- Same Inherit="False" requirement as the razor: CompEquippableAbility
         replaces CompEquippable, so the inherited comp list must be restated. -->
    <comps Inherit="False">
      <li Class="CompProperties_EquippableAbility">
        <abilityDef>RR_RazorWhip</abilityDef>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Biocodable"/>
    </comps>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <weaponTags>
      <li>UltratechMelee</li>
      <li>RR_RisingWeapon</li>
    </weaponTags>
    <weaponClasses>
      <li>Ultratech</li>
      <!-- MeleePiercer. There is no MeleeSharp WeaponClassDef. -->
      <li>MeleePiercer</li>
    </weaponClasses>
    <tools>
      <li>
        <label>haft</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>1.5</cooldownTime>
      </li>
      <li>
        <label>hook</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <!-- A sickle is a poor thrusting weapon; the straight razor stabs at 26. -->
        <power>17</power>
        <cooldownTime>2.1</cooldownTime>
        <armorPenetration>0.95</armorPenetration>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <!-- And a superb cutting one; the straight razor cuts at 27. -->
        <power>31</power>
        <cooldownTime>1.9</cooldownTime>
        <armorPenetration>0.95</armorPenetration>
      </li>
      <li>
        <label>lash</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>20</power>
        <cooldownTime>1.4</cooldownTime>
        <armorPenetration>0.6</armorPenetration>
      </li>
    </tools>
  </ThingDef>

</Defs>