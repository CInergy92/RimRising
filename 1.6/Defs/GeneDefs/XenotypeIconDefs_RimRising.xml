<?xml version="1.0" encoding="utf-8"?>
<!--
  One icon per Color, for carved pawns.

  A carving leaves the pawn Baseliner with only xenotypeName set, exactly as
  vanilla's xenogerm does. Pawn_GeneTracker.XenotypeIcon (decompiled) returns
  iconDef if set, else XenotypeIconDefOf.Basic for any pawn with a xenotypeName -
  so without these a carved Gold showed vanilla's generic custom-xenotype icon
  under the name "Gold". Recipe_CarveColor sets iconDef to RR_Icon_<Color>.

  texPath is each Color's own glyph from XenotypeDefs_Colors.xml, so nothing new
  is drawn. Side effect, a pleasant one: the Color glyphs also appear in the
  xenogerm editor's icon picker, so a player-assembled Color can wear its mark.

  Format mirrored from Biotech's XenotypeIconDefs (defName + texPath).
-->
<Defs>
  <XenotypeIconDef>
    <defName>RR_Icon_Gold</defName>
    <texPath>UI/Icons/Xenotypes/RR_Gold</texPath>
  </XenotypeIconDef>

  <XenotypeIconDef>
    <defName>RR_Icon_Bronzie</defName>
    <texPath>UI/Icons/Xenotypes/RR_Bronzie</texPath>
  </XenotypeIconDef>

