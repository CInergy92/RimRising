<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    The razor's whip lash: vanilla's cut in every respect but one field.

    CompAbilityEffect_RazorLash builds its own DamageInfo, with no verb behind it.
    When Combat Extended deflects a sharp hit it converts it to blunt and takes the
    blunt penetration from the attacking melee verb; with none it falls back to
    the DamageDef's defaultArmorPenetration, and with none of THAT it logs
    "has null verb, overriding AP" and uses 50 - far more than any razor's blunt
    figure. This def exists so that fallback has a real number: the CE folder sets
    it to the removed lash ToolCE's armorPenetrationBlunt.

    Without CE nothing reads it: the lash always passes an explicit penetration,
    and vanilla only falls back to the default for a negative one.
  -->
  <DamageDef ParentName="CutBase">
    <defName>RR_RazorLash</defName>
    <defaultArmorPenetration>0.75</defaultArmorPenetration>
  </DamageDef>

  <!--
    The pitviper's bite.

    Mirrored field for field from Alpha Animals' AA_ToxicBite
    (1.6/Defs/DamageDefs/Damage_AlphaPredators.xml): a stab that also raises a
    buildup hediff, scaled inversely by the victim's ToxicResistance. The only
    change is the hediff, which is vanilla ToxicBuildup rather than Alpha Animals'
    own, so this mod carries no dependency on theirs.

    severityPerDamageDealt 0.009 against a 7-power bite is about 0.06 severity per
    landed bite; three or four bites put an unresisting pawn into serious toxic
    buildup, one bite is survivable. That is the intended shape: the snake is a
    warning, the second snake is a problem.
  -->
  <DamageDef>
    <defName>RR_PitviperBite</defName>
    <label>pitviper bite</label>
    <workerClass>DamageWorker_Stab</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has been bitten to death.</deathMessage>
    <hediff>Stab</hediff>
    <hediffSolid>Crack</hediffSolid>
    <additionalHediffs>
      <li>
        <hediff>ToxicBuildup</hediff>
        <severityPerDamageDealt>0.009</severityPerDamageDealt>
        <victimSeverityScaling>ToxicResistance</victimSeverityScaling>
        <inverseStatScaling>true</inverseStatScaling>
      </li>
    </additionalHediffs>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Slice</impactSoundType>
    <armorCategory>Sharp</armorCategory>
  </DamageDef>

</Defs>
