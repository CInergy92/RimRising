<?xml version="1.0" encoding="utf-8" ?>
<!--
  Griffin. Suggestion 6.5, corrected by the user (2026-10-09): griffins are the
  OBSIDIANS' beasts - Carver-made, living wild in cold high country, ridden by the
  southern tribes - not a Gold house pet. The look (gold-fitted harness) was kept.

  STRUCTURE mirrored from Alpha Animals' AA_SandLion (Races_SandLion.xml): a large
  predator on the vanilla QuadrupedAnimalWithPawsAndTail body, Scratch/Bite/head
  tools, trainability Advanced, manhunterOnDamageChance 1, the life-stage and sound
  blocks. Leather_Heavy. Meat is auto-generated as for every animal.

  SIZE: thrumbo-class (the user's call). Vanilla's Thrumbo, read from
  Core/Defs/ThingDefs_Races/Races_Animal_MiscGroup.xml: body 4, health scale 8,
  combatPower 500, adult drawSize 4.8. The griffin is a predator rather than a
  tank: body 4, health 6.5, combatPower 450, drawSize 4.4 (its 512 px texture is
  wider than tall, so it reads as long as a thrumbo), damage about 1.35x the old
  bear-sized numbers. The setting puts its head near the size of a grown man.

  WHERE THEY COME FROM (all the user's picks): wild, rarely, in cold biomes
  (1.6/Patches/Biomes_Griffin.xml - below the megasloth, which sits at 0.1-0.2);
  the Obsidian tribes' hunting caravans and the Society quartermaster (tradeTag
  RR_GriffinBeast); and Obsidian tribe raids (Factions_RimRising.xml).
  NO FLIGHT: vanilla flight is an Odyssey mechanism and the animal would be gated.

  GRAPHICS: generated (fal) and fitted by Tools/Fit-GenAnimal.py, 512 px like the
  largest installed animals; sources in Art/Gen/Animals/Griffin.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RR_Griffin</defName>
    <label>griffin</label>
    <description>A Carver's beast of the cold south: a great cat's body under the head, neck and taloned forelegs of an eagle, with wings it folds and does not fly on. The head alone is nearly the size of a man, and the amber eyes in it are larger than his fist.\n\nThe Obsidian tribes ride them across ice that would kill a horse, and run them down wild in the high country when they need more. They tame badly, remember everything, and choose their rider rather than the other way round.</description>
    <statBases>
      <MoveSpeed>5.6</MoveSpeed>
      <ComfyTemperatureMin>-55</ComfyTemperatureMin>
      <ComfyTemperatureMax>50</ComfyTemperatureMax>
      <MarketValue>3600</MarketValue>
      <FilthRate>3</FilthRate>
      <Wildness>0.95</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left talon</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>23</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>25</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>right talon</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>23</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>25</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>30</power>
        <cooldownTime>1.9</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>20</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>14</power>
        <cooldownTime>1.75</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <herdAnimal>false</herdAnimal>
      <predator>true</predator>
      <maxPreyBodySize>3</maxPreyBodySize>
      <baseBodySize>4</baseBodySize>
      <baseHungerRate>1.4</baseHungerRate>
      <baseHealthScale>6.5</baseHealthScale>
      <foodType>CarnivoreAnimal, OvivoreAnimal</foodType>
      <leatherDef>Leather_Heavy</leatherDef>
      <trainability>Advanced</trainability>
      <petness>0.1</petness>
      <nameOnTameChance>1</nameOnTameChance>
      <manhunterOnTameFailChance>0.5</manhunterOnTameFailChance>
      <manhunterOnDamageChance>1</manhunterOnDamageChance>
      <gestationPeriodDays>28</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(1.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>60</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.4</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>1</minAge>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>RR_GriffinBeast</li>
      <!-- Not AnimalFighter: vanilla combat-supplier caravans sell that tag and the
           Sons of Ares use them. Griffins come from the tribes, the Society or the wild. -->
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RR_Griffin</defName>
    <race>RR_Griffin</race>
    <label>griffin</label>
    <combatPower>450</combatPower>
    <ecoSystemWeight>1</ecoSystemWeight>
    <canArriveManhunter>false</canArriveManhunter>
    <lifeStages>
      <li>
        <label>griffin cub</label>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RR_Griffin/RR_Griffin</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.2</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/RR_Griffin/RR_Griffin_Dessicated</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.2</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <label>young griffin</label>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RR_Griffin/RR_Griffin</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>3.6</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/RR_Griffin/RR_Griffin_Dessicated</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>3.6</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RR_Griffin/RR_Griffin</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>4.4</drawSize>
          <shadowData>
            <volume>(0.8, 0.6, 0.6)</volume>
            <offset>(0,0,-0.3)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/RR_Griffin/RR_Griffin_Dessicated</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>4.4</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
