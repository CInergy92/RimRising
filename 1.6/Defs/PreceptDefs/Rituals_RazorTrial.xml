<?xml version="1.0" encoding="utf-8" ?>
<!--
  Trial by razor. Suggestion 1.6.

  Golds settle standing by the blade. Ideology ships a duel ritual that almost nobody
  runs; a hierarchy ideoligion HAS to run this one, and the loser is a Gold.

  STRUCTURE mirrored from Vanilla Ideology Expanded - Memes' leadership challenge
  (1.6/Defs/Rituals/LeadershipChallenge/*.xml and Precepts_Ritual_LeadershipChallenge.xml),
  which is a duel to the death built on vanilla's duel machinery: RitualBehaviorWorker_Duel,
  the DropWeapon / ArriveToCell / SpeakOnCell / Duel duties, RitualPosition_DuelistStart,
  the Duel visual effect, GladiatorDuel_Start sound, Speech_Duel interaction and the
  NamerRitualGladiatorDuel name maker - all vanilla names that file uses. Four stages:
  duelists disarm, everyone gathers, the arbiter speaks, they fight.

  THREE THINGS DIFFER FROM VME, each because VME's version uses a class from its own DLL:

    - the duelists are RitualRoleColonist (used by VFE Empire's rituals), chosen by the
      player in the dialog, instead of VME's leader-plus-best-fighter roles. Gating
      them to Gold needs a RitualRoleColonist subclass reading RR_CasteIdentity - one
      short C# class, listed in docs/Opus-Notes.md. Until then any colonist may be
      named, and the hierarchy's own razor precept will object if a lowColor is
      handed a razor for it.
    - the fight ends with StageEndTrigger_PawnDead on each duelist (seen in VFE
      Tribals' animal rituals), one trigger per role, instead of VME's custom
      DeadDuelEnded. A duel to the death ends when someone dies.
    - the outcome worker is vanilla's RitualOutcomeEffectWorker_FromQuality. UNVERIFIED
      FROM HERE: every reference mod's outcome uses its own subclass, so the base
      class name is from memory. If it is wrong the precept errors on load naming
      this def; Find-VanillaDef.ps1 -Contains RitualOutcomeEffectWorker lists the
      real one.

  REQUIRED, not merely associated: in RR_ColorHierarchy's requireOne, per the
  associatedMemes lesson in CLAUDE.md, so every hierarchy ideoligion carries it.
  The precept's own requiredMemes keeps it off everything else.

  The speaker role is tagged Moralist as VME's is, so an ideoligion with no moralist
  substitutes. The speech is the arbiter's by rights (Roles_Colors.xml), but a role
  tag there would make the ritual depend on an optional role.
-->
<Defs>

  <PreceptDef>
    <defName>RR_Ritual_RazorTrial</defName>
    <label>trial by razor</label>
    <description>Two believers settle a question of standing with razors, before witnesses, to the death. The one who walks away was right.</description>
    <issue>Ritual</issue>
    <preceptClass>Precept_Ritual</preceptClass>
    <visible>true</visible>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <selectionWeight>1.0</selectionWeight>
    <ritualPatternBase>RR_RazorTrialPattern</ritualPatternBase>
    <iconPath>UI/Rituals/RR_RazorTrial</iconPath>
    <ignoreNameUniqueness>false</ignoreNameUniqueness>
    <useRepeatPenalty>false</useRepeatPenalty>
    <requiredMemes>
      <li>RR_ColorHierarchy</li>
    </requiredMemes>
  </PreceptDef>

  <RitualPatternDef>
    <defName>RR_RazorTrialPattern</defName>
    <ritualBehavior>RR_RazorTrialBehavior</ritualBehavior>
    <ritualObligationTargetFilter>RitualSpotOrAltar</ritualObligationTargetFilter>
    <nameMaker>NamerRitualGladiatorDuel</nameMaker>
    <canStartAnytime>true</canStartAnytime>
    <alwaysStartAnytime>true</alwaysStartAnytime>
    <ritualOutcomeEffect>RR_RazorTrialOutcome</ritualOutcomeEffect>
    <tags Inherit="False" />
    <ritualExpectedDesc>Standing among {MEMBERS} is settled by the blade. When two believers cannot agree who stands above the other, {RITUAL_labelDef} decides it.</ritualExpectedDesc>
  </RitualPatternDef>

  <RitualBehaviorDef>
    <defName>RR_RazorTrialBehavior</defName>
    <workerClass>RitualBehaviorWorker_Duel</workerClass>
    <roles>
      <li Class="RitualRoleTag">
        <label>speaker</label>
        <tag>Moralist</tag>
        <id>speaker</id>
        <precept>IdeoRole_Moralist</precept>
        <required>True</required>
        <substitutable>true</substitutable>
        <maxCount>1</maxCount>
        <countsAsParticipant>False</countsAsParticipant>
      </li>
      <li Class="RitualRoleColonist">
        <label>challenger</label>
        <categoryLabel>duelists</categoryLabel>
        <id>duelist1</id>
        <required>true</required>
        <maxCount>1</maxCount>
        <ignoreBleeding>true</ignoreBleeding>
        <countsAsParticipant>False</countsAsParticipant>
      </li>
      <li Class="RitualRoleColonist">
        <label>challenged</label>
        <categoryLabel>duelists</categoryLabel>
        <id>duelist2</id>
        <required>true</required>
        <maxCount>1</maxCount>
        <ignoreBleeding>true</ignoreBleeding>
        <countsAsParticipant>False</countsAsParticipant>
      </li>
    </roles>
    <spectatorsLabel>Witnesses</spectatorsLabel>
    <spectatorGerund>witness</spectatorGerund>
    <stages>
      <!-- Duelists drop whatever they carry; the razors are handed to them in the ring. -->
      <li>
        <defaultDuty>SpectateCircle</defaultDuty>
        <spectateDistanceOverride>5~7</spectateDistanceOverride>
        <endTriggers>
          <li Class="StageEndTrigger_RolesUnarmed">
            <roleIds>
              <li>duelist1</li>
              <li>duelist2</li>
            </roleIds>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>duelist1</roleId>
            <dutyDef>DropWeapon</dutyDef>
          </li>
          <li>
            <roleId>duelist2</roleId>
            <dutyDef>DropWeapon</dutyDef>
          </li>
        </roleBehaviors>
      </li>
      <!-- Everyone gathers. -->
      <li>
        <defaultDuty>SpectateCircle</defaultDuty>
        <spectateDistanceOverride>5~7</spectateDistanceOverride>
        <endTriggers>
          <li Class="StageEndTrigger_RolesArrived">
            <roleIds>
              <li>speaker</li>
              <li>duelist1</li>
              <li>duelist2</li>
            </roleIds>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>speaker</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_InCircle">
                <preferredRotation>North</preferredRotation>
                <distRange>3~3</distRange>
              </li>
            </customPositions>
          </li>
          <li>
            <roleId>duelist1</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_DuelistStart">
                <distFromTarget>2</distFromTarget>
                <duelistIndex>0</duelistIndex>
              </li>
            </customPositions>
          </li>
          <li>
            <roleId>duelist2</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_DuelistStart">
                <distFromTarget>2</distFromTarget>
                <duelistIndex>1</duelistIndex>
              </li>
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
      <!-- The speaker states the question. -->
      <li>
        <defaultDuty>SpectateCircle</defaultDuty>
        <spectateDistanceOverride>5~7</spectateDistanceOverride>
        <ignoreDurationToFinishAfterStage>true</ignoreDurationToFinishAfterStage>
        <postAction Class="RitualStageAction_SoundOneshotOnTarget">
          <sound>GladiatorDuel_Start</sound>
        </postAction>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>0.25</percentage>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>speaker</roleId>
            <dutyDef>SpeakOnCell</dutyDef>
            <speakerInteraction>Speech_Duel</speakerInteraction>
            <customPositions>
              <li Class="RitualPosition_InCircle">
                <preferredRotation>North</preferredRotation>
                <distRange>3~3</distRange>
              </li>
            </customPositions>
          </li>
          <li>
            <roleId>duelist1</roleId>
            <dutyDef>Idle</dutyDef>
          </li>
          <li>
            <roleId>duelist2</roleId>
            <dutyDef>Idle</dutyDef>
          </li>
        </roleBehaviors>
      </li>
      <!-- The trial. Ends when one of them is dead. -->
      <li>
        <defaultDuty>SpectateCircle</defaultDuty>
        <spectateDistanceOverride>5~7</spectateDistanceOverride>
        <visualEffectDef>Duel</visualEffectDef>
        <endTriggers>
          <li Class="StageEndTrigger_PawnDead">
            <roleId>duelist1</roleId>
          </li>
          <li Class="StageEndTrigger_PawnDead">
            <roleId>duelist2</roleId>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>speaker</roleId>
            <dutyDef>Idle</dutyDef>
            <customPositions>
              <li Class="RitualPosition_InCircle">
                <preferredRotation>North</preferredRotation>
                <distRange>3~3</distRange>
              </li>
            </customPositions>
          </li>
          <li>
            <roleId>duelist1</roleId>
            <dutyDef>Duel</dutyDef>
          </li>
          <li>
            <roleId>duelist2</roleId>
            <dutyDef>Duel</dutyDef>
          </li>
        </roleBehaviors>
      </li>
    </stages>
  </RitualBehaviorDef>

  <RitualOutcomeEffectDef>
    <defName>RR_RazorTrialOutcome</defName>
    <description>Depending on ritual quality, witnesses will get between {MINMOOD} and {MAXMOOD} mood for {MOODDAYS} days.</description>
    <!-- VERIFY: vanilla's quality-based outcome worker; see the file header. -->
    <workerClass>RitualOutcomeEffectWorker_FromQuality</workerClass>
    <extraPredictedOutcomeDescriptions>
      <li>This is a trial to the death. One of the duelists will not walk away.</li>
    </extraPredictedOutcomeDescriptions>
    <comps>
      <li Class="RitualOutcomeComp_RolePresentNotSubstituted">
        <roleId>speaker</roleId>
        <label>speaker present</label>
        <qualityOffset>0.2</qualityOffset>
      </li>
      <li Class="RitualOutcomeComp_RoomStat">
        <label>room impressiveness</label>
        <statDef>Impressiveness</statDef>
        <curve>
          <points>
            <li>0,  0</li>
            <li>50,  0.1</li>
            <li>120, 0.2</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>witness count</label>
        <curve>
          <points>
            <li>(1,  0.0)</li>
            <li>(4,  0.2)</li>
            <li>(8,  0.3)</li>
          </points>
        </curve>
      </li>
    </comps>
    <outcomeChances>
      <li>
        <chance>0.1</chance>
        <label>Shameful</label>
        <memory>RR_Thought_RazorTrial_Shameful</memory>
        <description>The trial was shameful. Neither would close, and the witnesses saw two Golds afraid of each other.</description>
        <roleIdsNotGainingMemory>
          <li>duelist1</li>
          <li>duelist2</li>
        </roleIdsNotGainingMemory>
        <positivityIndex>-2</positivityIndex>
      </li>
      <li>
        <chance>0.25</chance>
        <label>Adequate</label>
        <memory>RR_Thought_RazorTrial_Adequate</memory>
        <description>The trial was adequate. The question was settled, which was the point, and nobody will sing about it.</description>
        <positivityIndex>0</positivityIndex>
      </li>
      <li>
        <chance>0.45</chance>
        <label>Worthy</label>
        <memory>RR_Thought_RazorTrial_Worthy</memory>
        <description>The trial was worthy. Both went in meaning it, and the one who walked out earned the standing.</description>
        <positivityIndex>1</positivityIndex>
      </li>
      <li>
        <chance>0.2</chance>
        <label>Legendary</label>
        <memory>RR_Thought_RazorTrial_Legendary</memory>
        <description>The trial will be told for years. That is what a razor is for.</description>
        <positivityIndex>2</positivityIndex>
      </li>
    </outcomeChances>
  </RitualOutcomeEffectDef>

  <!-- Memories, mirrored from VME's Thoughts_LeadershipChallenge.xml. -->

  <ThoughtDef>
    <defName>RR_Thought_RazorTrial_Shameful</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>shameful trial by razor</label>
        <description>Two of ours stood in the ring and neither would close. I will not forget who I saw.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RR_Thought_RazorTrial_Adequate</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>trial by razor</label>
        <description>The question was settled the proper way.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RR_Thought_RazorTrial_Worthy</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>worthy trial by razor</label>
        <description>I watched two of ours settle it with the blade, and the better one is still standing.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RR_Thought_RazorTrial_Legendary</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>legendary trial by razor</label>
        <description>I was there. Whatever else happens to me, I was there for that.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
