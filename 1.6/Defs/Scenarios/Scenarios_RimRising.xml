<?xml version="1.0" encoding="utf-8" ?>
<!--
  Two starts at opposite ends of the hierarchy.

  Structure mirrored from Biotech/Defs/Scenarios/Scenarios.xml, whose Sanguophage
  start is the vanilla example of forcing specific xenotypes into the starting
  party via ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes.

  THE POINT IS THE ASYMMETRY. These are not two difficulty settings. One begins
  with a razor, pulse armor, research already done and a Gold to command; the
  other begins underground with three Reds, no weapons, and a lamp. Playing both
  should teach the hierarchy faster than any description of it.

  Neither start assumes an ideoligion - the player picks that at world creation,
  and picking RR_ColorEquality as a Gold, or RR_ColorHierarchy as a Red, is a
  perfectly coherent thing to do and produces the most interesting games.
-->
<Defs>

  <!-- ============================ the highColor start ===================== -->

  <ScenarioDef ParentName="ScenarioBase">
    <defName>RR_Scenario_Household</defName>
    <label>A Gold's Household</label>
    <description>A minor house, a long way from Luna, on a rock nobody important has visited in a generation.\n\nYou have a Gold to hold the seal, an Orange to keep the machines running, a Gray who has been told to obey, and Reds who were not consulted. You have equipment the rest of this world has never seen and standing that means nothing at this distance.\n\nEverything the Society says about who you all are travelled out here with you. Whether it survives contact with the work is a separate question.</description>
    <scenario>
      <summary>A Gold, a Gray, an Orange and two Reds, with Society equipment and standing.</summary>
      <parts>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The seal on the shuttle door is your family's, and out here that is worth exactly as much as the people who came with you agree it is.\n\nThey have been raised their whole lives to agree.</text>
          <closeSound>GameStartSting</closeSound>
        </li>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <customSummary>Start with one Gold, one Gray, one Orange and two Reds.</customSummary>
          <xenotypeCounts>
            <li>
              <xenotype>RR_Gold</xenotype>
              <count>1</count>
              <description>Gold</description>
              <requiredAtStart>true</requiredAtStart>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
            <li>
              <xenotype>RR_Gray</xenotype>
              <count>1</count>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
            <li>
              <xenotype>RR_Orange</xenotype>
              <count>1</count>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
            <li>
              <xenotype>RR_Red</xenotype>
              <count>2</count>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
          </xenotypeCounts>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <visible>false</visible>
          <method>DropPods</method>
        </li>

        <!-- A house arrives already knowing how to make its own things. -->
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>RR_PolyenneWeaving</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>RR_PulsePhysics</project>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>RR_Weapon_Razor</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>RR_Weapon_PulseFist</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_ChargeRifle</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>1200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>30</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Plasteel</thingDef>
          <count>150</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentSpacer</thingDef>
          <count>6</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>40</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>500</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>40</count>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

  <!-- ============================ the lowColor start ====================== -->

  <ScenarioDef ParentName="ScenarioBase">
    <defName>RR_Scenario_Breakout</defName>
    <label>Up From the Mine</label>
    <description>The shaft floods, the clan is written off, and the census never recorded your first name anyway.\n\nSo you came up. Not out of courage - out of the entirely ordinary wish to not drown. Now there is sky, which none of you have seen, and a horizon, which none of you have a word for, and nobody at all is coming to tell you what to do next.\n\nYou have a drill, a lamp, and hands that know one job. Everything else has to be worked out from scratch, by people the Society spent eight hundred years making sure could not.</description>
    <scenario>
      <summary>Three Reds up from a flooded shaft. No weapons, no education, no plan.</summary>
      <parts>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>Nobody is looking for you. That is the good news, and it is also all of the news.\n\nThe surface is cold and far too large, and the only skill any of you has is digging. It will have to be enough for a while.</text>
          <closeSound>GameStartSting</closeSound>
        </li>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>10</pawnChoiceCount>
          <customSummary>Start with three Reds.</customSummary>
          <xenotypeCounts>
            <li>
              <xenotype>RR_Red</xenotype>
              <count>3</count>
              <description>Red</description>
              <requiredAtStart>true</requiredAtStart>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
          </xenotypeCounts>
        </li>

        <!-- Walked up out of the ground, rather than dropped from orbit. -->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <visible>false</visible>
          <method>Standing</method>
        </li>

        <li Class="ScenPart_NoPossessions">
          <def>NoPossessions</def>
        </li>

        <!-- What you can carry out of a flooding shaft, and no more. -->
        <!-- "You have a drill": the tool every Red holds all day (Weapons_SlingBlade_RimRising.xml). -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>RR_Weapon_SlingBlade</thingDef>
          <count>3</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSimple</thingDef>
          <count>12</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>6</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>120</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>WoodLog</thingDef>
          <count>150</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>60</count>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

  <!-- ============================== the Rising ============================= -->
  <!--
    The third start, and deliberately not a harder Breakout.

    Breakout is anonymity: the shaft flooded, the census never had your name, and
    nobody is looking for you. This is the opposite. A cell of the Rising is a
    thing the Society already knows exists and is already hunting, and it is made
    of people from Colors that are not supposed to be able to stand in the same
    room - which is the entire argument the Rising is making, expressed as a party
    composition rather than as a description.

    STARTS WITH KINDS, NOT XENOTYPES. ScenPart_ConfigPage_ConfigureStartingPawns_
    KindDefs lets the party be actual Sons of Ares pawn kinds, so a Gray defector
    arrives with a Gray's marksmanship and an Orange saboteur with an Orange's
    hands. Picking xenotypes alone would have produced the right Colors with the
    wrong lives behind them.

    NO IDEOLIGION IS FORCED, because RimWorld ships no ScenPart that can set one -
    checked against every ScenPart vanilla uses. Color equality has to be chosen on
    the ideoligion page, and the description says so rather than leaving the player
    to discover that the premise did not take.

    THE FIRST RAID IS SCHEDULED. Every other start waits for the storyteller. This
    one does not, because being found is the premise rather than a risk.
  -->

  <ScenarioDef ParentName="ScenarioBase">
    <defName>RR_Scenario_Rising</defName>
    <label>A Cell of the Rising</label>
    <description>Five people who by every rule of the Society should never have met, in a hole in the ground with somebody else's weapons.

A Gold who was not supposed to be able to doubt. A Gray who was told to shoot and did not. An Orange whose hands are worth more than the rest of the cell combined. Two Reds who were never asked whether any of it was acceptable, and have now answered.

The Society knows the Rising exists. It does not yet know you do, and that will not last.

Pick Color equality on the ideoligion page - the premise of this start is that the castes are a lie, and the game cannot assume that for you.</description>
    <scenario>
      <summary>A cross-Color insurgent cell. Stolen gear, powerful enemies, and a first raid already on the way.</summary>
      <parts>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The five of you agree on almost nothing except the one thing.

Outside, the Society is a fact so large it is mistaken for weather. In here it is five people and a stolen razor, which is a worse ratio than it sounds and a better one than it has ever been.</text>
          <closeSound>GameStartSting</closeSound>
        </li>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs">
          <def>ConfigurePawnsKindDefs</def>
          <pawnChoiceCount>10</pawnChoiceCount>
          <kindCounts>
            <li>
              <kindDef>RR_Ares_Gold_Turncoat</kindDef>
              <count>1</count>
              <requiredAtStart>true</requiredAtStart>
            </li>
            <li>
              <kindDef>RR_Ares_Gray_Defector</kindDef>
              <count>1</count>
            </li>
            <li>
              <kindDef>RR_Ares_Orange_Saboteur</kindDef>
              <count>1</count>
            </li>
            <li>
              <kindDef>RR_Ares_Red_Fighter</kindDef>
              <count>2</count>
            </li>
          </kindCounts>
        </li>

        <!-- Inserted, or shot down. Either reading works. -->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <visible>false</visible>
          <method>DropPods</method>
        </li>

        <!--
          Taken, not issued. A razor in a lowColor's hands is the single most
          inflammatory object in the setting, and the Rising began in part with
          exactly that.
        -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>RR_Weapon_Razor</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_AssaultRifle</thingDef>
          <count>2</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>18</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>15</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>350</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>25</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>400</count>
        </li>

        <!--
          The Orange brought her trade with her. One research project, and it is
          the one that makes armour possible later rather than anything immediate.
        -->
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>RR_PolyenneWeaving</project>
        </li>

        <!--
          Being found is the premise. Scheduled early enough to set the tone and
          late enough to build something first.
        -->
        <li Class="ScenPart_CreateIncident">
          <def>CreateIncident</def>
          <incident>RaidEnemy</incident>
          <minDays>4</minDays>
          <maxDays>7</maxDays>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
