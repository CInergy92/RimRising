<!--
  Cupid's Kiss - the obedience implant.

  Item, hediff and install recipe live together in one file, which is vanilla's own
  layout for an implant: Core's Joywire ThingDef, HediffDef and InstallJoywire
  recipe all sit in the same file. This is modelled on the Joywire specifically,
  which is the closest thing RimWorld already ships - a brain implant that trades a
  person's capacity for a change in how they feel.

  WHAT IT IS, MECHANICALLY

  The reference describes a device around the spine that inflicts constant pain,
  switched off only by obedience, so that compliance and relief become the same
  sensation. RimWorld already has the machinery for exactly that idea in Ideology's
  slave suppression, so the implant is expressed as:

      a large SlaveSuppressionOffset   - the conditioning working as designed
      permanent low-grade pain         - the burning and the headache
      a consciousness penalty          - what it costs to live inside that

  Nothing here needed inventing, and nothing about it is sexual. It is a compliance
  device, and it is filed next to the joywire because that is what it is: a way of
  buying somebody's cooperation out of their own nervous system.

  ADULTS ONLY. The reference has these fitted in childhood and removed around
  twelve. That part is deliberately not modelled - minAllowedAge and
  developmentalStageFilter both refuse it on anyone who is not an adult. The
  Society's practice can be described without the game offering it as an option.

  It can be removed, and removing it returns the item. A colony that takes one out
  of somebody is doing something meaningful, and the mod should let it.
-->
<Defs>

  <ThingDef ParentName="BodyPartBionicBase">
    <defName>RR_CupidsKiss</defName>
    <label>Cupid's Kiss</label>
    <description>A slim lattice that clasps the spinal column and keeps a low fire burning in it, alongside a headache that never fully lifts. The fire goes out when its wearer does as they are told, and comes back when they stop.\n\nNobody who has worn one describes it as pain, exactly. They describe it as the shape of the day.</description>
    <descriptionHyperlinks><RecipeDef>RR_InstallCupidsKiss</RecipeDef></descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Item/Health/RR_CupidsKiss</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>950</MarketValue>
      <Mass>0.4</Mass>
    </statBases>
    <costList>
      <Plasteel>12</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
  </ThingDef>

  <HediffDef ParentName="ImplantHediffBase">
    <defName>RR_CupidsKissInstalled</defName>
    <label>Cupid's Kiss</label>
    <labelNoun>a Cupid's Kiss</labelNoun>
    <description>An installed obedience lattice. It maintains a constant low pain in the spine and skull, easing only while its wearer complies, so that relief and obedience become the same feeling. The effect on compliance is dramatic. The effect on the person is not nothing.</description>
    <descriptionHyperlinks><ThingDef>RR_CupidsKiss</ThingDef></descriptionHyperlinks>
    <spawnThingOnRemoved>RR_CupidsKiss</spawnThingOnRemoved>
    <stages>
      <li>
        <!-- The burning and the headache. Constant, and deliberately not severe:
             the device is built to be endurable forever, not to incapacitate. -->
        <painOffset>0.12</painOffset>
        <!-- Living inside it costs attention. Same shape as the joywire's cost. -->
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.08</offset>
          </li>
        </capMods>
        <statOffsets>
          <SlaveSuppressionOffset>0.45</SlaveSuppressionOffset>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <RecipeDef ParentName="SurgeryInstallImplantBase">
    <defName>RR_InstallCupidsKiss</defName>
    <label>install Cupid's Kiss</label>
    <description>Install a Cupid's Kiss around the spine.</description>
    <descriptionHyperlinks>
      <ThingDef>RR_CupidsKiss</ThingDef>
      <HediffDef>RR_CupidsKissInstalled</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing Cupid's Kiss.</jobString>
    <workAmount>2400</workAmount>
    <!--
      The age gate. The reference fits these to children; this mod does not offer
      that. Both fields are set rather than one, because they are checked in
      different places and either alone leaves a route in.
    -->
    <minAllowedAge>18</minAllowedAge>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RR_CupidsKiss</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RR_CupidsKiss</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Spine</li>
    </appliedOnFixedBodyParts>
    <addsHediff>RR_CupidsKissInstalled</addsHediff>
  </RecipeDef>

</Defs>
