    <weaponMoney>800~1700</weaponMoney>
    <apparelTags Inherit="False">
      <!-- Rank-and-file Gray. Had NO apparelTags at all, so it could generate any apparel in the game including recoil plate. -->
      <li>RR_BasicPlate</li>
      <li>IndustrialBasic</li>
    </apparelTags>
    <weaponTags>
      <li>IndustrialGunAdvanced</li>
      <li>SpacerGun</li>
    </weaponTags>
    <skills>
      <li><skill>Shooting</skill><range>5~11</range></li>
    </skills>
    <xenotypeSet>
