<!--
  Pawn kinds for the Colors.

  Mirrored from Royalty/Defs/PawnKinds/PawnKinds_Empire.xml. Royalty-only fields
  (minTitleRequired, royalTitle*) are deliberately not used - Royalty is not a
  dependency.

  THE KEY FIELD

    <useFactionXenotypes>false</useFactionXenotypes>
    <xenotypeSet><xenotypeChances><RR_Gray>1</RR_Gray></xenotypeChances></xenotypeSet>

  This pins a pawn kind to a Color, overriding the faction's own spread. It is how
  the caste system becomes visible in play: a Society legion arrives and it is
  Grays with Obsidian shock troops and a Gold at the head, because each role is
  bound to the Color that the Society breeds for it. Verified on
  Empire_Fighter_Trooper.

  Weapon and apparel tags are all vanilla and all verified present. Milestone 4
  adds RimRising's own equipment; these will be revisited then to use it.

  combatPower drives raid arithmetic. Values are set relative to vanilla anchors
  (Empire trooper 65) so points-based raids are not wildly mis-sized.
-->
<Defs>

  <!-- =========================== abstract bases =========================== -->

  <PawnKindDef Name="RR_ColorPawnBase" Abstract="True">
    <race>Human</race>
    <maxGenerationAge>65</maxGenerationAge>
    <!--
      Required on every humanlike pawn kind; omitting either is a load-time config
      error. Set on the shared base so all kinds inherit, with elite kinds
      overriding upward. Ranges mirrored from vanilla usage.
    -->
    <initialResistanceRange>10~17</initialResistanceRange>
    <initialWillRange>1~3</initialWillRange>
    <useFactionXenotypes>false</useFactionXenotypes>
  </PawnKindDef>

  <PawnKindDef Name="RR_SocietyFighterBase" ParentName="RR_ColorPawnBase" Abstract="True">
    <defaultFactionDef>RR_Society</defaultFactionDef>
    <itemQuality>Normal</itemQuality>
    <apparelAllowHeadgearChance>0.7</apparelAllowHeadgearChance>
    <apparelTags>
      <li>IndustrialMilitaryBasic</li>
      <li>IndustrialMilitaryAdvanced</li>
      <li>SpacerMilitary</li>
    </apparelTags>
    <apparelDisallowTags>
      <li>Western</li>
      <li>Neolithic</li>
    </apparelDisallowTags>
  </PawnKindDef>

