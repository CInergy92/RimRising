<!--
  Trader kinds. Suggestions 1.2 and 1.3.

  Until now every faction in the mod sold vanilla outlander stock, which was the one
  place the Society still read as "an outlander town with Golds in it". Each faction
  now has its own caravans, and what they carry is the faction's character:

    RR_Caravan_Society_Census    pays in STANDING, not silver. Buys what the Society
                                 taxes - helium, ionsteel, people - and that is how a
                                 colony climbs the Gold ladder (RoyalTitles_Gold.xml)
                                 without the Empire's quests.
    RR_Caravan_Society_Armory    silver; the Society's issue kit, duroArmor and
                                 scorchers, and the drugs it feeds its Grays.
    RR_Caravan_Dominion_Mining   silver; the Rim sells what it digs and builds.
    RR_Caravan_Julii_Trade       silver; everything, including slaves. The house that
                                 will sell anyone anything.
    RR_Caravan_Sun_Armory        silver; the one merchant that arms the Rising -
                                 recoilArmor, pulseFists, implants. RR_Scenario_Rising
                                 promised this in its description.
    RR_Caravan_Tribe_Hunters     silver; god's bread, fever cloud, pelts. Buys the
                                 steel it is not supposed to have.

  STRUCTURE mirrored from Vanilla Factions Expanded - Medieval 2's
  TraderKinds_Caravan_Viking.xml and TraderKinds_Caravan_Medieval.xml: defName,
  label, commonality, stockGenerators. Generator classes and their fields are only
  the ones seen there and in Alpha Animals' traders: StockGenerator_SingleDef
  (thingDef, countRange), _Tag (tradeTag, thingDefCountRange, countRange),
  _BuyTradeTag (tag), _BuySingleDef (thingDef), _BuyExpensiveSimple, _Slaves
  (respectPopulationIntent, countRange), _Animals (maxWildness, checkTemperature,
  tradeTagsSell, kindCountRange? - NOT seen; animals use the tag form only).

  The favour caravans were drafted from memory and are now verified against
  Royalty's tribute collector - see the note above them.

  WIRED IN: FactionDefs/Factions_RimRising.xml and Factions_Merchants.xml list these
  under caravanTraderKinds, REPLACING the vanilla outlander entries so the stock IS
  the faction. Visitor and base traders stay vanilla for now.
-->
<Defs>

  <!-- ====================== the Society: census caravan ==================== -->

  <!--
    Both census caravans mirror Royalty's Empire_Caravan_TributeCollector (verified
    2026-10-09): tradeCurrency Favor and faction are real TraderKindDef fields, and
    favour trading is not Empire-only in code. What an item pays is its
    RoyalFavorValue STAT (TradeUtility.GetPricePlayerSell), not its market value, and
    the stat defaults to 0 - so a favour trader must only buy things that carry it.
    Vanilla's buys slaves (Human: 3) and gold (0.015). Steel, plasteel and uranium
    carry none and were dropped: the caravan would have taken them for nothing.
    Ionsteel and helium-3 carry it at gold's rate (Items_*_RimRising.xml).
    hideThingsNotWillingToTrade and requestable False are the collector's too.
  -->
  <TraderKindDef>
    <defName>RR_Caravan_Society_Census</defName>
    <label>census caravan</label>
    <requestable>False</requestable>
    <commonality>1.5</commonality>
    <tradeCurrency>Favor</tradeCurrency>
    <faction>RR_Society</faction>
    <hideThingsNotWillingToTrade>True</hideThingsNotWillingToTrade>
    <stockGenerators>
      <!-- The Society does not sell. It takes, and it pays in standing. Bodies are
           a tax too. -->
      <li Class="StockGenerator_BuySlaves" />
      <li Class="StockGenerator_BuyTradeTag">
        <tag>RR_SocietyTribute</tag>
      </li>
      <li Class="StockGenerator_BuySingleDef">
        <thingDef>Gold</thingDef>
      </li>
    </stockGenerators>
  </TraderKindDef>

  <!-- The Rim's own census: the same arrangement, a different flag. Favour with the
       Dominion is not favour with Luna (RoyalTitles_Service.xml, Dominion ladder). -->
  <TraderKindDef>
    <defName>RR_Caravan_Dominion_Census</defName>
    <label>Rim census caravan</label>
    <requestable>False</requestable>
    <commonality>1.2</commonality>
    <tradeCurrency>Favor</tradeCurrency>
    <faction>RR_RimDominion</faction>
    <hideThingsNotWillingToTrade>True</hideThingsNotWillingToTrade>
    <stockGenerators>
      <li Class="StockGenerator_BuySlaves" />
      <li Class="StockGenerator_BuyTradeTag">
        <tag>RR_SocietyTribute</tag>
      </li>
    </stockGenerators>
  </TraderKindDef>

  <!-- ======================= the Society: armory caravan =================== -->

  <TraderKindDef>
    <defName>RR_Caravan_Society_Armory</defName>
    <label>Society quartermaster</label>
    <commonality>1</commonality>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>900~1600</countRange>
      </li>
      <!-- Issue kit. The Society sells its Grays' gear; it does not sell its Golds'. -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_Apparel_DuroArmor</thingDef>
        <countRange>2~5</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_Weapon_Scorcher</thingDef>
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_Nazopran</thingDef>
        <countRange>6~16</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_Zoladone</thingDef>
        <countRange>4~12</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_ResFlesh</thingDef>
        <countRange>3~8</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineIndustrial</thingDef>
        <countRange>6~14</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentIndustrial</thingDef>
        <countRange>8~20</countRange>
      </li>
      <!-- A griffin, now and then. Races_Animal_Griffin.xml; sold nowhere else. -->
      <li Class="StockGenerator_Animals">
        <maxWildness>1</maxWildness>
        <checkTemperature>false</checkTemperature>
        <tradeTagsSell>
          <li>RR_SocietyBeast</li>
        </tradeTagsSell>
      </li>
      <li Class="StockGenerator_BuyTradeTag">
        <tag>RR_SocietyTribute</tag>
      </li>
      <li Class="StockGenerator_BuyExpensiveSimple" />
    </stockGenerators>
  </TraderKindDef>

  <!-- ============================ the Rim Dominion ========================= -->

  <TraderKindDef>
    <defName>RR_Caravan_Dominion_Mining</defName>
    <label>Rim mining concern</label>
    <commonality>1</commonality>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>700~1300</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_Ionsteel</thingDef>
        <countRange>40~120</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_HeliumThree</thingDef>
        <countRange>20~60</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Steel</thingDef>
        <countRange>200~500</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Plasteel</thingDef>
        <countRange>40~120</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentIndustrial</thingDef>
        <countRange>10~24</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_Apparel_DuroArmor</thingDef>
        <countRange>1~3</countRange>
      </li>
      <!-- The Rim drives a hard bargain and buys what it cannot dig. -->
      <li Class="StockGenerator_BuySingleDef">
        <thingDef>MedicineIndustrial</thingDef>
      </li>
      <li Class="StockGenerator_BuyTradeTag">
        <tag>Art</tag>
      </li>
      <li Class="StockGenerator_BuyExpensiveSimple" />
    </stockGenerators>
  </TraderKindDef>

  <!-- ============================== house Julii ============================ -->

  <TraderKindDef>
    <defName>RR_Caravan_Julii_Trade</defName>
    <label>Julii factor</label>
    <commonality>1.2</commonality>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>1200~2400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_Ionsteel</thingDef>
        <countRange>20~60</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_HeliumThree</thingDef>
        <countRange>10~40</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentSpacer</thingDef>
        <countRange>2~6</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineUltratech</thingDef>
        <countRange>2~6</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_CarvingKit</thingDef>
        <countRange>0~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_ResFlesh</thingDef>
        <countRange>2~6</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>ExoticMisc</tradeTag>
        <thingDefCountRange>2~3</thingDefCountRange>
        <countRange>1~1</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>TechHediff</tradeTag>
        <thingDefCountRange>1~3</thingDefCountRange>
        <countRange>1</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>Art</tradeTag>
        <countRange>2~5</countRange>
      </li>
      <!-- The house that sells anyone anything. -->
      <li Class="StockGenerator_Slaves">
        <respectPopulationIntent>true</respectPopulationIntent>
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_BuyTradeTag">
        <tag>RR_SocietyTribute</tag>
      </li>
      <li Class="StockGenerator_BuyTradeTag">
        <tag>Art</tag>
      </li>
      <li Class="StockGenerator_BuyExpensiveSimple" />
    </stockGenerators>
  </TraderKindDef>

  <!-- =============================== house Sun ============================= -->

  <TraderKindDef>
    <defName>RR_Caravan_Sun_Armory</defName>
    <label>Sun broker</label>
    <commonality>1</commonality>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>800~1500</countRange>
      </li>
      <!-- The one merchant that arms the Rising. -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_Apparel_RecoilArmor</thingDef>
        <countRange>0~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_Weapon_PulseFist</thingDef>
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_Weapon_Scorcher</thingDef>
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_Apparel_GravBoots</thingDef>
        <countRange>0~1</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_SynapticLattice</thingDef>
        <countRange>0~1</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_CupidsKiss</thingDef>
        <countRange>0~1</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_MjolnirSix</thingDef>
        <countRange>3~9</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentSpacer</thingDef>
        <countRange>1~4</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>SpacerGun</tradeTag>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>1~1</countRange>
      </li>
      <li Class="StockGenerator_BuySingleDef">
        <thingDef>RR_HeliumThree</thingDef>
      </li>
      <li Class="StockGenerator_BuySingleDef">
        <thingDef>RR_Ionsteel</thingDef>
      </li>
      <li Class="StockGenerator_BuyExpensiveSimple" />
