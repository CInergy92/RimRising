  <!-- =========================== the Obsidian tribes ======================= -->

  <TraderKindDef>
    <defName>RR_Caravan_Tribe_Hunters</defName>
    <label>Obsidian hunting party</label>
    <commonality>1</commonality>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>200~500</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_GodsBread</thingDef>
        <countRange>6~16</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RR_FeverCloud</thingDef>
