<!--
  Factions.

  Mirrored from Royalty/Defs/FactionDefs/Faction_Empire.xml and
  Core/Defs/FactionDefs/Factions_Misc.xml. Royalty is a dependency since Milestone 5:
  the Society and the Rim Dominion carry royalFavor* and royalTitleTags for the Gold
  and service ladders in Defs/RoyalTitles.

  techLevel values verified against the TechLevel enum by decompiling
  Assembly-CSharp: Undefined, Animal, Neolithic, Medieval, Industrial, Spacer,
  Ultra, Archotech.

  THE HIERARCHY SHOULD BE LEGIBLE ON THE WORLD MAP

  Each faction's xenotypeSet is its demographic profile, and its pawnGroupMakers
  decide who actually turns up. The Society fields Grays in bulk with Obsidian
  shock troops and, rarely, a single Gold. The resistance fields Reds in bulk with
  whatever it has managed to turn. You should be able to read a faction's politics
  off the raid that arrives, before reading a word of description.

  Faction icons and name makers reuse vanilla assets for now; bespoke ones are art
  and naming work for a later pass.
-->
<Defs>

  <!-- ============================== the Society =========================== -->

  <FactionDef ParentName="FactionBase">
    <defName>RR_Society</defName>
    <label>the Society</label>
    <description>The order that owns the solar system, and the arithmetic that keeps it standing. Every person inside it is born into a Color, works the trade that Color was engineered for, and answers to the Colors above. It is not presented as politics. It is presented as biology, which is much harder to argue with.\n\nAt the top sit the Golds, who are genuinely superior and have spent eight centuries making sure everyone knows it. Beneath them the high, mid and low Colors grade downward through administration, craft and labor to the Reds in the mines, who are numerous, short-lived, and told they are lucky.\n\nThe Society trades, garrisons and occasionally obliterates. It regards a colony of mixed Colors doing as it pleases as a clerical error awaiting correction.</description>
    <pawnSingular>Society citizen</pawnSingular>
    <pawnsPlural>Society citizens</pawnsPlural>
    <categoryTag>RR_Society</categoryTag>
    <listOrderPriority>60</listOrderPriority>
    <settlementGenerationWeight>1.2</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>3</maxConfigurableAtWorldCreation>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>sovereign</leaderTitle>
    <!--
      Royalty title machinery. royalTitleTags must match the <tags> on the titles
      in Defs/RoyalTitles. Golds earn standing by serving the Society; the
      Institute is what confers it in the fiction, and favor is the only currency
      RimWorld's title system understands.
    -->
    <royalFavorLabel>standing</royalFavorLabel>
    <royalFavorIconPath>UI/Icons/RoyalFavor</royalFavorIconPath>
    <royalTitleTags>
      <li>RR_GoldTitle</li>
      <!-- The service ladder Obsidians and Grays climb; see
           Defs/RoyalTitles/RoyalTitles_Service.xml. -->
      <li>RR_ServiceTitle</li>
    </royalTitleTags>
    <royalTitleInheritanceWorkerClass>RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>
    <techLevel>Spacer</techLevel>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <!-- The Society takes the good ground first and always has. Temperate tiles, and it concedes the extremes to everyone else. -->
    <minSettlementTemperatureChanceCurve>
      <points>
        <li>(-40, 0.03)</li>
        <li>(-12, 0.35)</li>
        <li>(2, 1)</li>
        <li>(16, 1)</li>
        <li>(28, 0.25)</li>
      </points>
    </minSettlementTemperatureChanceCurve>
    <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
    <factionNameMaker>NamerFactionOutlander</factionNameMaker>
    <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
    <colorSpectrum>
      <li>(0.85, 0.72, 0.28)</li>
      <li>(1.0, 0.92, 0.62)</li>
    </colorSpectrum>
    <!--
      Drives the goodwill situations in Defs/Goodwill: a colony sharing this meme
      is embraced, one holding the opposite is loathed.
    -->
    <!--
      Restricts ideoligion generation. Omitting this draws from the full default
      spread, real-world origin memes included.
    -->
    <structureMemeWeights>
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">6</Structure_Ideological>
      <Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">2</Structure_Archist>
    </structureMemeWeights>    <requiredMemes>
      <li>RR_ColorHierarchy</li>
    </requiredMemes>    <xenotypeSet>
      <!--
        Demographics, not power ranking. Reds are the overwhelming bulk; Golds are
        a rounding error who nonetheless run the place.
      -->
      <xenotypeChances>
        <RR_Red>0.34</RR_Red>
        <RR_Gray>0.14</RR_Gray>
        <RR_Brown>0.11</RR_Brown>
        <RR_Orange>0.08</RR_Orange>
        <RR_Obsidian>0.05</RR_Obsidian>
        <RR_Pink>0.05</RR_Pink>
        <RR_Green>0.04</RR_Green>
        <RR_Blue>0.04</RR_Blue>
        <RR_Yellow>0.04</RR_Yellow>
        <RR_Copper>0.03</RR_Copper>
        <RR_Violet>0.02</RR_Violet>
        <RR_White>0.02</RR_White>
        <RR_Silver>0.015</RR_Silver>
        <RR_Bronzie>0.012</RR_Bronzie>
        <RR_Gold>0.008</RR_Gold>
      </xenotypeChances>
    </xenotypeSet>
    <!--
      Required for any humanlike faction with pawnGroupMakers. Omitting either is
      a load-time config error. Curve shape mirrored from Faction_Empire.xml;
      backstory categories verified present in Core/Defs/BackstoryDefs.
    -->
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(70, 60)</li>
        <li>(300, 150)</li>
        <li>(1000, 400)</li>
        <li>(2000, 800)</li>
        <li>(2001, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
          <li>Outlander</li>
        </categories>
      </li>
    </backstoryFilters>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <RR_Society_Green_Bellator>2</RR_Society_Green_Bellator>
          <RR_Society_Legionary>10</RR_Society_Legionary>
          <RR_Society_Obsidian_Knight>3</RR_Society_Obsidian_Knight>
          <RR_Society_Lurcher>1.5</RR_Society_Lurcher>
          <RR_Society_Bronzie_Officer>1.5</RR_Society_Bronzie_Officer>
          <RR_Society_Gold_Praetor>0.4</RR_Society_Gold_Praetor>
          <RR_Society_OlympicKnight>0.08</RR_Society_OlympicKnight>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <RR_Society_Silver_Factor>1</RR_Society_Silver_Factor>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Dromedary>5</Dromedary>
          <Alpaca>2</Alpaca>
          <Elephant>1</Elephant>
        </carriers>
        <guards>
          <RR_Society_Legionary>10</RR_Society_Legionary>
          <RR_Society_Obsidian_Knight>2</RR_Society_Obsidian_Knight>
          <RR_Society_Bronzie_Officer>1</RR_Society_Bronzie_Officer>
        </guards>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <RR_Society_White_Arbiter>2</RR_Society_White_Arbiter>
          <RR_Society_Blue_Helmsman>3</RR_Society_Blue_Helmsman>
          <RR_Society_Violet_Artisan>2</RR_Society_Violet_Artisan>
          <RR_Society_Pink_Companion>3</RR_Society_Pink_Companion>
          <RR_Society_Pink_Rose>0.4</RR_Society_Pink_Rose>
          <RR_Society_Copper_Official>3</RR_Society_Copper_Official>
          <RR_Society_Yellow_Medicus>4</RR_Society_Yellow_Medicus>
          <RR_Society_Silver_Factor>3</RR_Society_Silver_Factor>
          <RR_Society_Brown_Servant>6</RR_Society_Brown_Servant>
          <RR_Society_Red_Laborer>8</RR_Society_Red_Laborer>
          <RR_Society_Legionary>4</RR_Society_Legionary>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <RR_Society_Legionary>10</RR_Society_Legionary>
          <RR_Society_Obsidian_Knight>3</RR_Society_Obsidian_Knight>
          <RR_Society_Lurcher>1</RR_Society_Lurcher>
          <RR_Society_Bronzie_Officer>1.5</RR_Society_Bronzie_Officer>
          <RR_Society_Gold_Praetor>0.3</RR_Society_Gold_Praetor>
          <RR_Society_OlympicKnight>0.06</RR_Society_OlympicKnight>
        </options>
      </li>
    </pawnGroupMakers>
    <!-- The Society sells everything and is short of nothing. Full industrial trade, exotics included. -->
    <caravanTraderKinds>
      <li>Caravan_Outlander_BulkGoods</li>
      <li>Caravan_Outlander_CombatSupplier</li>
      <li>Caravan_Outlander_Exotic</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_Outlander_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Base_Outlander_Standard</li>
    </baseTraderKinds>
    <!--
      Without this the faction generates with NO LEADER and the log fills with
      "Faction leader for <name> is null" - all seven of ours did.

      Faction.TryGenerateNewLeader (decompiled) draws only from pawnGroupMakers
      whose kindDef is Combat, and only from options whose PawnKindDef sets
      factionLeader true - or from this list. fixedLeaderKinds is the better
      lever here because it does not force the leader to be a combat option:
      a trademaster should lead Julii without having to be a raider first.
    -->
    <fixedLeaderKinds>
      <li>RR_Society_Gold_Praetor</li>
    </fixedLeaderKinds>
  </FactionDef>

  <!-- ============================ the Rim Dominion ========================= -->

  <FactionDef ParentName="FactionBase">
    <defName>RR_RimDominion</defName>
    <label>Rim Dominion</label>
    <description>Gold rule as practised a very long way from anyone who could correct it. The Dominion keeps the Colors, keeps the breeding registries, and keeps a cordial distance from the Society it technically belongs to - an arrangement both sides describe as tradition and neither mistakes for loyalty.\n\nDistance has made them harder. Their Reds are bred dense for crushing gravity, their fleets are older and better handled, and their Golds regard the inner worlds as decadent. What the Dominion wants is rarely the same as what the Society wants, and it has never once been asked.</description>
    <pawnSingular>Dominion citizen</pawnSingular>
    <pawnsPlural>Dominion citizens</pawnsPlural>
    <categoryTag>RR_Society</categoryTag>
    <listOrderPriority>55</listOrderPriority>
    <settlementGenerationWeight>0.7</settlementGenerationWeight>
    <maxConfigurableAtWorldCreation>2</maxConfigurableAtWorldCreation>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>archgovernor</leaderTitle>
    <!--
      Royalty title machinery. royalTitleTags must match the <tags> on the titles
      in Defs/RoyalTitles. Golds earn standing by serving the Society; the
      Institute is what confers it in the fiction, and favor is the only currency
      RimWorld's title system understands.
    -->
    <royalFavorLabel>standing</royalFavorLabel>
    <royalFavorIconPath>UI/Icons/RoyalFavor</royalFavorIconPath>
    <royalTitleTags>
      <li>RR_GoldTitle</li>
      <!-- The service ladder Obsidians and Grays climb; see
           Defs/RoyalTitles/RoyalTitles_Service.xml. -->
      <li>RR_ServiceTitle</li>
    </royalTitleTags>
    <royalTitleInheritanceWorkerClass>RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>
    <techLevel>Spacer</techLevel>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <!-- The Rim holds the cold moons. Cool and harsh, but short of polar. -->
    <minSettlementTemperatureChanceCurve>
      <points>
        <li>(-60, 0.2)</li>
        <li>(-25, 1)</li>
        <li>(-2, 1)</li>
        <li>(12, 0.25)</li>
        <li>(25, 0.05)</li>
      </points>
    </minSettlementTemperatureChanceCurve>
    <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
    <factionNameMaker>NamerFactionOutlander</factionNameMaker>
    <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
    <colorSpectrum>
      <li>(0.62, 0.55, 0.30)</li>
      <li>(0.90, 0.84, 0.55)</li>
    </colorSpectrum>
    <!--
      Drives the goodwill situations in Defs/Goodwill: a colony sharing this meme
      is embraced, one holding the opposite is loathed.
    -->
    <!--
      Restricts ideoligion generation. Omitting this draws from the full default
      spread, real-world origin memes included.
    -->
    <structureMemeWeights>
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">5</Structure_Ideological>
      <Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">2</Structure_Archist>
      <Structure_TheistEmbodied MayRequire="Ludeon.RimWorld.Ideology">1</Structure_TheistEmbodied>
    </structureMemeWeights>    <!--
      PainIsVirtue alongside the hierarchy meme. FactionDef.requiredMemes really
      does force these at generation - IdeoUtility adds them to the meme list
      directly - and an NPC ideoligion takes one to three normal memes, so two
      forced ones fit.

      DELIBERATELY NOT ON THE SOCIETY. PainIsVirtue carries its own requireOne
      chain: Pain_Idealized, Comfort_Ignored, SlabBed_Preferred. Austerity and
      slab beds suit a hard dominion on the cold moons and suit exiles on the ice.
      They do not suit Luna, whose whole character is that it is comfortable, and
      forcing it there would make the Society read as ascetic rather than
      decadent. The Society still scars - that comes from the meme's own
      Scarification requirement - it simply does not venerate the pain.
    -->
    <requiredMemes>
      <li>RR_ColorHierarchy</li>
      <li>PainIsVirtue</li>
    </requiredMemes>    <xenotypeSet>
      <xenotypeChances>
        <RR_Red>0.22</RR_Red>
        <RR_Red_Ultraheavy>0.14</RR_Red_Ultraheavy>
        <RR_Gray>0.13</RR_Gray>
