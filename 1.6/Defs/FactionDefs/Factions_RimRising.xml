    <backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
          <li>Outlander</li>
        </categories>
      </li>
    </backstoryFilters>    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <RR_Society_Legionary>9</RR_Society_Legionary>
          <RR_Society_Obsidian_Knight>4</RR_Society_Obsidian_Knight>
          <RR_Society_Bronzie_Officer>2</RR_Society_Bronzie_Officer>
          <RR_Society_Gold_Praetor>0.5</RR_Society_Gold_Praetor>
          <RR_Society_OlympicKnight>0.1</RR_Society_OlympicKnight>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <RR_Society_Silver_Factor>1</RR_Society_Silver_Factor>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Dromedary>5</Dromedary>
        </carriers>
        <guards>
          <RR_Society_Legionary>8</RR_Society_Legionary>
          <RR_Society_Obsidian_Knight>3</RR_Society_Obsidian_Knight>
        </guards>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <RR_Society_White_Arbiter>2</RR_Society_White_Arbiter>
          <RR_Society_Blue_Helmsman>3</RR_Society_Blue_Helmsman>
          <RR_Society_Violet_Artisan>2</RR_Society_Violet_Artisan>
          <RR_Society_Pink_Companion>3</RR_Society_Pink_Companion>
          <RR_Society_Copper_Official>3</RR_Society_Copper_Official>
          <RR_Society_Red_Laborer>8</RR_Society_Red_Laborer>
          <RR_Society_Brown_Servant>5</RR_Society_Brown_Servant>
          <RR_Society_Legionary>4</RR_Society_Legionary>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <RR_Society_Legionary>10</RR_Society_Legionary>
          <RR_Society_Obsidian_Knight>4</RR_Society_Obsidian_Knight>
          <RR_Society_Bronzie_Officer>1.5</RR_Society_Bronzie_Officer>
        </options>
      </li>
    </pawnGroupMakers>
    <!-- The Rim trades in what it mines and what it builds, and drives a harder bargain than Luna does. -->
    <caravanTraderKinds>
      <li>Caravan_Outlander_BulkGoods</li>
      <li>Caravan_Outlander_CombatSupplier</li>
      <li>Caravan_Outlander_Exotic</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_Outlander_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Base_Outlander_Standard</li>
    </baseTraderKinds>
    <!--
      Without this the faction generates with NO LEADER and the log fills with
      "Faction leader for <name> is null" - all seven of ours did.

      Faction.TryGenerateNewLeader (decompiled) draws only from pawnGroupMakers
      whose kindDef is Combat, and only from options whose PawnKindDef sets
      factionLeader true - or from this list. fixedLeaderKinds is the better
      lever here because it does not force the leader to be a combat option:
      a trademaster should lead Julii without having to be a raider first.
    -->
    <fixedLeaderKinds>
      <li>RR_Society_Gold_Praetor</li>
    </fixedLeaderKinds>
  </FactionDef>

  <!-- ============================ the resistance =========================== -->

