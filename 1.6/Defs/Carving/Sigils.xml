  <!-- ============================ forging one ============================= -->

  <RecipeDef Abstract="True" Name="RR_ForgeSigilBase" ParentName="SurgeryFlesh">
    <workerClass>RimRising.Recipe_ForgeSigil</workerClass>
    <workAmount>4000</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>true</isViolation>
    <surgerySuccessChanceFactor>1.2</surgerySuccessChanceFactor>
    <deathOnFailedSurgeryChance>0</deathOnFailedSurgeryChance>
    <researchPrerequisite>RR_Carving</researchPrerequisite>
    <anesthetize>true</anesthetize>
    <skillRequirements>
      <Medicine>8</Medicine>
    </skillRequirements>
    <modExtensions>
      <li Class="RimRising.RR_CarverWork" />
    </modExtensions>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RR_ResFlesh</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RR_ResFlesh</li>
      </thingDefs>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>

