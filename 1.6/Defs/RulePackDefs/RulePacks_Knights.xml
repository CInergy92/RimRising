<?xml version="1.0" encoding="utf-8" ?>
<!--
  Name makers for the knighthoods.

  Precept_Role.GenerateNameRaw() runs the nameMaker through GrammarResolver
  unconditionally. A role precept with no nameMaker therefore throws a
  NullReferenceException the moment an ideoligion containing it is generated -
  which took out Dialog_ChooseMemes, Page_ConfigureIdeo and WorldGenStep at once,
  for 2831 errors, none of which named this mod. Every vanilla role has one.

  Unlike vanilla roles, whose names are generated from meme vocabulary, a
  knighthood has one fixed canonical title. So each rule pack resolves to exactly
  one string - the title itself - rather than composing from [memeAdjective] and
  friends. Structure mirrored from Ideology/Defs/RulePackDefs/RulePacks_Ideo_Role.xml.
-->
<Defs>

  <RulePackDef>
    <defName>RR_NamerKnight_Morning</defName>
    <rulePack>
      <rulesStrings>
        <li>r_roleName->Morning Knight</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

