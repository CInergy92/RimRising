<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      RimWorld 1.6 runs on Unity's Mono, which targets .NET Framework 4.7.2.
      Microsoft.NETFramework.ReferenceAssemblies supplies the reference assemblies
      so this builds on a machine with no .NET Framework targeting pack installed.
    -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RimRising</AssemblyName>
    <RootNamespace>RimRising</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!-- The mod ships only the DLL; RimWorld loads it from 1.6/Assemblies. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\1.6\Assemblies\</OutputPath>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>

    <!-- Never copy the game's assemblies into the mod folder. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    REFERENCE PACKAGES, NOT THE INSTALL. Compiling against the game's own DLLs
    meant only a machine with RimWorld installed could build this - not a cloud
    session, not CI. These packages carry the same public API as reference
    assemblies, version-pinned to the exact game build:

      Krafs.Rimworld.Ref 1.6.4871  = RimWorld 1.6.4871 (Version.txt), which also
                                     carries the UnityEngine modules, including
                                     ScreenCaptureModule for TestScene.cs
      Lib.Harmony 2.4.1            = the Harmony mod's 0Harmony.dll

    Both stay compile-time only. Krafs ships reference assemblies, which are
    never copied; Lib.Harmony's runtime DLL is excluded, because the game
    already loads Harmony and a second copy in the mod would be harmful.
    Verified after the switch: 1.6/Assemblies still holds only RimRising.dll, and
    its referenced assemblies are identical to the build against the install.

    Bump both when the game or Harmony updates.
  -->
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.4.1" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
