<?xml version="1.0" encoding="utf-8"?>
<!--
  This machine's global NuGet config resolves only to "Microsoft Visual Studio
  Offline Packages", which does not carry Microsoft.NETFramework.ReferenceAssemblies.
  <clear /> drops that inherited source for this folder only, so the build does not
  depend on the developer's global NuGet setup, and nothing outside Source/ changes.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
