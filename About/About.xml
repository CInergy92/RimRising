<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>RimRising</name>
  <author>cinergy92</author>
  <packageId>cinergy92.rimrising</packageId>
  <modIconPath IgnoreIfNoMatchingField="True">UI/RimRisingModIcon</modIconPath>
  <description>A total conversion built around an engineered caste hierarchy: fourteen Colors, each a xenotype with its own capabilities and its own costs, bound together by a social order that gives the hierarchy real mechanical weight.

Requires Biotech for the Color system and Ideology for the caste hierarchy.

This mod is a work in progress.</description>

  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>

  <modDependencies>
    <li>
      <packageId>Ludeon.RimWorld.Biotech</packageId>
      <displayName>Biotech</displayName>
    </li>
    <li>
      <packageId>Ludeon.RimWorld.Ideology</packageId>
      <displayName>Ideology</displayName>
    </li>
    <li>
      <packageId>Ludeon.RimWorld.Royalty</packageId>
      <displayName>Royalty</displayName>
    </li>    <li>
      <packageId>Nals.FacialAnimation</packageId>
      <displayName>[NL] Facial Animation</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=1635901197</steamWorkshopUrl>
    </li>
    <li>
      <packageId>Oppey.EyeGenes2</packageId>
      <displayName>[BT] EyeGenes2 | Base - [NL] Facial Animation</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=2898151329</steamWorkshopUrl>
    </li>
    <li>
      <packageId>EBSG.AiO</packageId>
      <displayName>Expanded Biotech Style Genes - All in One</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=3020821838</steamWorkshopUrl>
    </li>
    <!--
      Harmony and Vanilla Expanded Framework are not used by RimRising directly -
      our own assembly needs neither. They are here because Alpha Genes requires
      both, and RimWorld does not resolve transitive dependencies: a mod that does
      not declare them gets no warning, and the user finds out via a red log.
      Declared explicitly so the mod list tells the truth about what is needed.
    -->
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
    <li>
      <packageId>OskarPotocki.VanillaFactionsExpanded.Core</packageId>
      <displayName>Vanilla Expanded Framework</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=2023507013</steamWorkshopUrl>
      <downloadUrl>https://github.com/Vanilla-Expanded/VanillaExpandedFramework</downloadUrl>
    </li>
    <li>
      <packageId>sarg.alphagenes</packageId>
      <displayName>Alpha Genes</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=2891845502</steamWorkshopUrl>
    </li>
    <li>
      <packageId>EBSG.Archite</packageId>
      <displayName>Expanded Archite Genes</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=3039936922</steamWorkshopUrl>
    </li>
    <li>
      <packageId>Petre27.BiotechCapacitorGenes</packageId>
      <displayName>Biotech Capacitor Genes</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=2882220355</steamWorkshopUrl>
    </li>
    <li>
      <packageId>BobnikTheIII.LifespanExpectancyGenes</packageId>
      <displayName>Lifespan Expectancy Genes</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=3364691662</steamWorkshopUrl>
    </li>
    <!--
      EBSG's own LoadFolders gates 1.6/Mods/EBSGFull behind IfModActive="EBSG.Framework",
      and EBSG_FertilityShortening lives in there. Without the framework active the
      gene does not exist and Red fails to resolve it at load.
    -->
    <li>
      <packageId>EBSG.Framework</packageId>
      <displayName>EBSG Framework</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=3112549163</steamWorkshopUrl>
    </li>
  </modDependencies>

  <loadAfter>
    <li>Ludeon.RimWorld</li>
    <li>Ludeon.RimWorld.Royalty</li>
    <li>Ludeon.RimWorld.Ideology</li>
    <li>Ludeon.RimWorld.Biotech</li>
    <li>Ludeon.RimWorld.Anomaly</li>
    <li>Ludeon.RimWorld.Odyssey</li>
    <li>brrainz.harmony</li>
    <!-- VFE Core must load before Alpha Genes, which must load before us. -->
    <li>OskarPotocki.VanillaFactionsExpanded.Core</li>
    <li>Nals.FacialAnimation</li>
    <li>Oppey.EyeGenes2</li>
    <li>EBSG.AiO</li>
    <li>sarg.alphagenes</li>
    <li>EBSG.Archite</li>
    <li>EBSG.Framework</li>
    <li>Petre27.BiotechCapacitorGenes</li>
    <li>BobnikTheIII.LifespanExpectancyGenes</li>
    <!--
      Optional, not required: the user commonly runs it, so we load after it to
      keep ordering correct when it is present. Not a modDependency - the mod
      works without it.
    -->
    <li>Nals.FacialAnimationExperimentals</li>
  </loadAfter>
</ModMetaData>
