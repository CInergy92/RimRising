<?xml version="1.0" encoding="utf-8"?>
<!--
  Load order for RimRising.

  <li>/</li>  = the repo root, holding version-independent assets:
                Textures/, Sounds/, Languages/
  <li>1.6</li> = version-specific content: Defs/, Patches/, Assemblies/

  Conditional folders are added here ONLY once the folder actually exists.
  Listing a path that is not on disk has not been verified as safe, so we do
  not speculate. Still planned, each to be added when its folder is created:

    1.6/Mods/RimJobWorld      IfModActive="rim.job.world"
    1.6/Mods/Anomaly          IfModActive="Ludeon.RimWorld.Anomaly"
-->
<loadFolders>
  <v1.6>
    <li>/</li>
    <li>1.6</li>
    <!--
      Combat Extended support. OPTIONAL AND NEVER REQUIRED - CE is not a
      modDependency, and everything in this folder is patches over defs that
      already work on their own. Without CE the folder is never loaded and the
      mod runs on its vanilla stats.

      CE rescales both armor and armor penetration into different units, so the
      vanilla numbers are not merely unbalanced under CE, they are meaningless.
      Hence patches rather than shared values.
    -->
    <!--
      Carvelings. OPTIONAL AND NEVER REQUIRED - Alpha Animals is not a
      modDependency, and would have been an eighth required subscription.
      Nothing outside this folder refers to it, so without Alpha Animals the
      folder is never loaded and the only thing missing is Carvelings.

      Additive only: it adds a Carver route to Alpha Animals' creatures and does
      not touch a single one of their defs. Re-describing their animals as
      Society-made would have rewritten another mod's content for the player's
      whole game, in factions and biomes that have nothing to do with this one.
    -->
    <li IfModActive="sarg.alphaanimals">1.6/Mods/AlphaAnimals</li>
    <li IfModActive="CETeam.CombatExtended">1.6/Mods/CombatExtended</li>
    <!--
      starShell support. OPTIONAL AND NEVER REQUIRED - the Exosuit Framework is
      not a modDependency, and nothing outside this folder refers to it, so
      without the framework the folder is never loaded and nothing is missing
      except the starShell itself.

      The framework earns its place here rather than being avoided: a starShell in
      the source is a four-metre powered suit with modular weapon mounts, flight
      and heavy fuel use, which is exactly the shape the framework models. Faking
      it as ordinary apparel would have meant one static armour piece pretending to
      be a walking tank.
    -->
    <li IfModActive="Aoba.Exosuit.Framework">1.6/Mods/Exosuit</li>
    <!--
      Drachenjager support. OPTIONAL AND NEVER REQUIRED, same arrangement as the
      Exosuit folder above.

      A Drachenjager is forty metres tall, filed under Vehicles on the reference
      wiki, and has a cockpit hunched between its shoulders instead of a head -
      pilots bolt into it the way a Blue syncs with a ship. That is a piloted
      vehicle, not worn apparel, so the Exosuit Framework is the wrong tool for it
      no matter how hard it is bent. This one belongs to Vehicle Framework.
    -->
    <li IfModActive="SmashPhil.VehicleFramework">1.6/Mods/Vehicles</li>
    <!--
      [NL] Realistic Body support. OPTIONAL AND NEVER REQUIRED. Holds only
      textures: worn-armour sprites redrawn with greaves for the three body types
      Realistic Body retextures (Male, Female, Thin), whose legs run below the
      vanilla body box where our base sprites stop.

      MUST STAY LAST. Decompiled: ModContentPack.AddFolders walks this list
      backwards, and GetAllFilesForMod keeps the FIRST file it finds per path, so
      the last-listed folder wins. Listed last, these override the base sprites
      at the same paths - for Realistic Body players only.
    -->
    <li IfModActive="nals.realisticbody">1.6/Mods/RealisticBody</li>
    <!--
      Dragons Descent: its dragons and drake retold as Carver-made (the user's
      call, 2026-10-09). Optional, descriptions only; not a dependency.
    -->
    <li IfModActive="onyxae.dragonsdescent">1.6/Mods/DragonsDescent</li>
    <!-- Giddy-Up 2 - Continued: griffins rideable, Obsidian raiders mounted.
         Optional; not a dependency. -->
    <li IfModActive="MemeGoddess.GiddyUp">1.6/Mods/GiddyUp</li>
    <!-- Odyssey: gravships burn helium-3 (Patches/Gravship_Helium.xml). -->
    <li IfModActive="Ludeon.RimWorld.Odyssey">1.6/Mods/Odyssey</li>
  </v1.6>
</loadFolders>
