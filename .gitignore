# Build output
[Bb]in/
[Oo]bj/
*.user
*.suo

# Tooling cache (vanilla def index, rebuilt on demand)
Tools/.cache/

# The compiled mod assembly is a build artifact of /Source.
# Uncomment once Source/ produces it, so it is not committed twice.
# 1.6/Assemblies/*.dll
# 1.6/Assemblies/*.pdb

# Generated art candidates awaiting review. The chosen one is copied into
# Textures/ and committed there; the rest are churn. Art/Silhouettes IS committed -
# it is the ControlNet input, so keeping it makes a regeneration reproducible.
Art/Review/

# Test-scene screenshots (Source/RimRising/TestScene.cs). ~8 MB each, regenerated
# in minutes by re-running the scene, and they had grown to 236 MB of history.
Art/Tests/

# Python bytecode from the Blender-run tools
__pycache__/

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Scratch left by an interrupted git filter-branch; never content.
.git-rewrite/

# Raw generations: about 1 MB each and reproducible from fal_manifest.jsonl. Kept in git:
# the manifests, orig/ (the fit targets) and the chosen style images.
Art/Gen/Armor/**/gen*.png
Art/Gen/Armor/**/ref*.png
Art/Gen/Armor/**/demon*.png
Art/Gen/Armor/**/style_*_2.png
!Art/Gen/Armor/Duro/style_Male_south_2.png
!Art/Gen/Armor/Cloak/style_Male_south_2.png
!Art/Gen/Armor/Helm/demonB_south_2.png
Art/Gen/Weapons/gen_*.png
Art/Gen/Weapons/ref_*.png
!Art/Gen/Armor/Pulse/gen_Male_south.png
Art/Gen/Vehicles/**/gen_*.png
Art/Gen/Vehicles/**/ref_*.png
Art/Gen/Vehicles/**/style_*.png
Art/Gen/Vehicles/**/dj_south.png
Art/Gen/Vehicles/**/dj_south_2.png
# Second content pass (2026-10-09): keep the chosen sources a rerun fits from,
# not the rejected alternates.
Art/Gen/Animals/**/*_2.png
Art/Gen/Buildings/**/*_2.png
Art/Gen/Weapons/rejected/
!Art/Gen/Armor/Pelt/style_Male_south.png
Art/Gen/Armor/**/rejected/
!Art/Gen/Vehicles/RipWing/rw_south_2.png

# Local-only side mods (e.g. a personal CE patch set). Kept on disk, never committed.
Extras/
